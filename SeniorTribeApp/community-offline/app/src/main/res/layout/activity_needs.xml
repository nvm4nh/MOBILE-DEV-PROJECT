<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F6F2"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhu cầu"
        android:textColor="#19231F"
        android:textSize="25sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:background="#E4EEE8"
        android:padding="4dp">

        <TextView
            android:id="@+id/btnReceived"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Đơn vị ghi nhận"
            android:textColor="#617068"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnAvailable"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:text="Tìm để tiếp nhận"
            android:textColor="#19231F"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSearchNeed"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_f05_input"
        android:hint="⌕  Tìm theo từ khóa..."
        android:singleLine="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#19231F"
        android:textColorHint="#829087"
        android:textSize="14sp"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDistrict"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_filter_selected"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Quận 3  ▾"
            android:textColor="#104C40"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnTopic"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_filter_outline"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Chủ đề  ▾"
            android:textColor="#202923"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnTime"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_filter_outline"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Thời gian  ▾"
            android:textColor="#202923"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutNeedState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStateIcon"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#207A66"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvStateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Chưa có nhu cầu phù hợp"
            android:textColor="#19231F"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Thử bỏ bớt bộ lọc khu vực hoặc chủ đề để xem thêm nhu cầu đang cần."
            android:textColor="#617068"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnStateAction"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_f05_button"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Xóa bộ lọc"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
