<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F6F3"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Đăng bài"
                android:textColor="#18201C"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans" />
        </LinearLayout>

        <!-- Posting organization -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_f05_org"
            android:gravity="center_vertical"
            android:minHeight="78dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_f05_avatar"
                android:gravity="center"
                android:text="ĐT"
                android:textColor="#1F6F5C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng với tư cách"
                    android:textColor="#52615A"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Đoàn Thanh niên Phường 7"
                    android:textColor="#18201C"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Title label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tiêu đề"
            android:textColor="#52615A"
            android:textSize="18sp" />

        <!-- Title input -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_f05_input"
            android:gravity="center_vertical"
            android:hint="Ngày hội thăm hỏi tháng 10"
            android:inputType="textCapSentences"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:textColor="#18201C"
            android:textColorHint="#84938A"
            android:textSize="21sp" />

        <!-- Content label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Nội dung"
            android:textColor="#52615A"
            android:textSize="18sp" />

        <!-- Content input -->
        <EditText
            android:id="@+id/etContent"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_f05_input"
            android:gravity="top|start"
            android:hint="Sáng Chủ nhật 20/10, đoàn viên Phường 7 đến thăm và trò chuyện cùng 15 cụ trong khu phố..."
            android:inputType="textCapSentences|textMultiLine"
            android:padding="20dp"
            android:scrollbars="vertical"
            android:textColor="#18201C"
            android:textColorHint="#84938A"
            android:textSize="20sp" />

        <!-- Privacy warning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_f05_notice"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top"
                android:layout_marginEnd="14dp"
                android:contentDescription="Cảnh báo bảo mật"
                android:src="@drawable/ic_warning_f05"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Không đăng tên, địa chỉ, số điện thoại hay ảnh của người được hỗ trợ."
                android:textColor="#A96100"
                android:textSize="18sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Visibility scope -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Các tổ chức trong mạng lưới"
                android:src="@drawable/ic_users_f05"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hiển thị cho các tổ chức trong mạng lưới"
                android:textColor="#52615A"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Publish button -->
        <TextView
            android:id="@+id/btnPublish"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_f05_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Đăng bài"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
