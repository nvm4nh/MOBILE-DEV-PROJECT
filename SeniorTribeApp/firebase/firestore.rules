rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // HÀM CHUNG
    // ================================================================

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function membershipPath(uid, orgId) {
      return /databases/$(database)/documents/memberships/$(uid)/organizations/$(orgId);
    }

    function isMember(orgId) {
      return signedIn()
        && orgId is string
        && exists(membershipPath(request.auth.uid, orgId))
        && get(membershipPath(request.auth.uid, orgId)).data.active == true;
    }

    // Cờ mạng lưới memberships/{uid} { active } do quản trị ghi: true khi tài khoản đang có
    // ít nhất một quyền tổ chức còn hiệu lực. Dùng khi không biết trước orgId (R02).
    function inNetwork() {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.active == true;
    }

    function hasRole(orgId, role) {
      return isMember(orgId)
        && role in get(
          membershipPath(request.auth.uid, orgId)
        ).data.roles;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isText(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen;
    }

    // ================================================================
    // TÀI KHOẢN
    // ================================================================

    function validContactPhone(value) {
      return value is string
        && (
          value == ''
          || value.matches('[+]?[0-9]{8,15}')
        );
    }

    function validProfile(data, uid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'area',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'area',
          'phone',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.email is string
        && data.email == request.auth.token.email
        && data.area is string
        && data.area.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validContactPhone(data.get('phone', ''));
    }

    match /users/{uid} {
      allow get: if owns(uid);

      allow list: if false;

      allow create: if owns(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && request.resource.data.uid == uid
        && changed().hasOnly([
          'displayName',
          'area',
          'phone',
          'email',
          'updatedAt'
        ])
        && (
          !changed().hasAny(['displayName'])
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 2
            && request.resource.data.displayName.size() <= 80
          )
        )
        && (
          !changed().hasAny(['area'])
          || (
            request.resource.data.area is string
            && request.resource.data.area.size() <= 120
          )
        )
        && (
          !changed().hasAny(['phone'])
          || validContactPhone(
            request.resource.data.get('phone', '')
          )
        )
        && (
          !changed().hasAny(['email'])
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() >= 3
            && request.resource.data.email.size() <= 254
            && request.resource.data.email
              == request.auth.token.get('email', '')
            && request.auth.token.get(
              'email_verified', false
            ) == true
          )
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ================================================================
    // TỔ CHỨC VÀ PHÂN QUYỀN
    // ================================================================

    match /memberships/{uid} {
      allow get: if owns(uid);
      allow list, write: if false;
    }

    match /memberships/{uid}/organizations/{organizationId} {
      allow get, list: if owns(uid);
      allow create, update, delete: if false;
    }

    match /organizations/{orgId} {
      allow get: if signedIn();
      allow list, write: if false;

      match /members/{memberUid} {
        allow read: if isMember(orgId);
        allow write: if false;
      }
    }

    // ================================================================
    // HÀM HỖ TRỢ NHU CẦU, TIẾP NHẬN VÀ LỊCH
    // ================================================================

    function needPath(needId) {
      return /databases/$(database)/documents/needs_summary/$(needId);
    }

    function assignmentPath(assignmentId) {
      return /databases/$(database)/documents/needs_assignments/$(assignmentId);
    }

    function schedulePath(assignmentId, scheduleId) {
      return /databases/$(database)/documents/needs_assignments/$(assignmentId)/schedules/$(scheduleId);
    }

    function validSummary(d) {
      return isText(d.title, 5, 120)
        && isText(d.topic, 1, 60)
        && isText(d.content, 10, 1000)
        && isText(d.area, 2, 120)
        && isText(d.desiredTime, 1, 120)
        && isText(d.source, 1, 200)
        && d.consentRecorded == true
        && isText(d.consentMethod, 1, 200);
    }

    function editableKeys() {
      return [
        'title',
        'topic',
        'content',
        'area',
        'desiredTime',
        'source',
        'consentRecorded',
        'consentMethod',
        'status',
        'needsRevision',
        'updatedAt',
        'submittedAt'
      ];
    }

    function lockedKeys() {
      return [
        'caseCode',
        'recorderOrgId',
        'recorderOrgName',
        'recorderUid',
        'recorderName',
        'createdAt'
      ];
    }

    function canReadNeed(d) {
      return signedIn()
        && (
          (d.status == 'OPEN' && inNetwork())
          || isMember(d.recorderOrgId)
          || isMember(d.get('assignedOrgId', '-'))
        );
    }

    // ================================================================
    // NHU CẦU HỖ TRỢ
    // ================================================================

    match /needs_summary/{needId} {
      allow read: if canReadNeed(resource.data);

      allow create: if hasRole(
          request.resource.data.recorderOrgId,
          'RECORDER'
        )
        && request.resource.data.keys().hasOnly([
          'caseCode',
          'title',
          'topic',
          'content',
          'area',
          'desiredTime',
          'source',
          'consentRecorded',
          'consentMethod',
          'status',
          'needsRevision',
          'reviewNote',
          'recorderOrgId',
          'recorderOrgName',
          'recorderUid',
          'recorderName',
          'assignedOrgId',
          'assignedOrgName',
          'assigneeUid',
          'assigneeName',
          'currentAssignmentId',
          'returnCount',
          'createdAt',
          'updatedAt',
          'submittedAt'
        ])
        && request.resource.data.recorderUid == request.auth.uid
        && request.resource.data.status == 'REVIEW'
        && request.resource.data.needsRevision == false
        && request.resource.data.assignedOrgId == null
        && request.resource.data.assigneeUid == null
        && request.resource.data.currentAssignmentId == null
        && request.resource.data.returnCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.caseCode is string
        && getAfter(
          /databases/$(database)/documents/counters/needs
        ).data.get('lastNeedId', null) == needId
        && validSummary(request.resource.data);

      allow update: if signedIn()
        && !changed().hasAny(lockedKeys())
        && (
          recorderEdits()
          || reviewerDecides()
          || representativeAccepts()
          || representativeReturns()
          || recorderCancels()
          || coordinationStep()
        );

      allow delete: if false;

      function recorderEdits() {
        return hasRole(resource.data.recorderOrgId, 'RECORDER')
          && resource.data.status in ['REVIEW', 'OPEN']
          && request.resource.data.status == 'REVIEW'
          && request.resource.data.needsRevision == false
          && changed().hasOnly(editableKeys())
          && validSummary(request.resource.data);
      }

      function reviewerDecides() {
        return hasRole(resource.data.recorderOrgId, 'REVIEWER')
          && request.auth.uid != resource.data.recorderUid
          && resource.data.status == 'REVIEW'
          && request.resource.data.reviewerUid == request.auth.uid
          && changed().hasOnly([
            'status',
            'needsRevision',
            'reviewNote',
            'reviewerUid',
            'reviewerName',
            'reviewedAt',
            'updatedAt'
          ])
          && (
            (
              request.resource.data.status == 'OPEN'
              && request.resource.data.needsRevision == false
            )
            || (
              request.resource.data.status == 'REVIEW'
              && request.resource.data.needsRevision == true
              && isText(request.resource.data.reviewNote, 1, 500)
            )
          );
      }

      function representativeAccepts() {
        let d = request.resource.data;

        return resource.data.status == 'OPEN'
          && resource.data.get('currentAssignmentId', null) == null
          && d.status == 'ACCEPTED'
          && hasRole(d.assignedOrgId, 'REPRESENTATIVE')
          && d.acceptedByUid == request.auth.uid
          && d.assigneeUid is string
          && exists(membershipPath(d.assigneeUid, d.assignedOrgId))
          && get(membershipPath(d.assigneeUid, d.assignedOrgId)).data.active == true
          && d.currentAssignmentId is string
          && existsAfter(assignmentPath(d.currentAssignmentId))
          && changed().hasOnly([
            'status',
            'assignedOrgId',
            'assignedOrgName',
            'assigneeUid',
            'assigneeName',
            'acceptedByUid',
            'currentAssignmentId',
            'acceptedAt',
            'updatedAt'
          ]);
      }

      // Trả lại (F14): lịch đã chốt với tổ chức cũ phải xóa hết, không để sót giờ kết thúc / hình thức
      function representativeReturns() {
        let d = request.resource.data;

        return resource.data.status in ['ACCEPTED', 'SCHEDULED']
          && hasRole(resource.data.assignedOrgId, 'REPRESENTATIVE')
          && d.status == 'OPEN'
          && isText(d.get('lastReturnReason', null), 1, 200)
          && d.assignedOrgId == null
          && d.assigneeUid == null
          && d.currentAssignmentId == null
          && d.returnCount == resource.data.get('returnCount', 0) + 1
          && changed().hasOnly([
            'status',
            'assignedOrgId',
            'assignedOrgName',
            'assigneeUid',
            'assigneeName',
            'acceptedByUid',
            'currentAssignmentId',
            'acceptedAt',
            'returnCount',
            'lastReturnReason',
            'updatedAt',
            'scheduleId',
            'scheduledAt',
            'scheduledEndAt',
            'scheduledFormat',
            'scheduledPlace',
            'scheduledByUid'
          ])
          && d.get('scheduleId', null) == null
          && d.get('scheduledAt', null) == null
          && d.get('scheduledEndAt', null) == null
          && d.get('scheduledFormat', null) == null
          && d.get('scheduledPlace', null) == null
          && d.get('scheduledByUid', null) == null;
      }

      function recorderCancels() {
        let d = request.resource.data;

        return hasRole(resource.data.recorderOrgId, 'RECORDER')
          && !(resource.data.status in ['COMPLETED', 'CANCELLED'])
          && d.status == 'CANCELLED'
          && isText(d.cancelReason, 1, 200)
          && d.cancelledByUid == request.auth.uid
          && changed().hasOnly([
            'status',
            'cancelReason',
            'cancelNote',
            'cancelledByUid',
            'cancelledAt',
            'updatedAt'
          ]);
      }

      function coordinationStep() {
        return recorderConfirmsSchedule()
          || rescheduleConfirmed()
          || assignedOrgReportsDelivered()
          || recorderNotesReconcile()
          || recorderCompletes();
      }

      // E02 · Đổi lịch đã chốt: nhu cầu vẫn SCHEDULED nhưng trỏ sang lịch mới.
      // Lịch mới phải là yêu cầu đổi lịch đã được bên còn lại xác nhận (rule của schedules
      // kiểm tra ai được xác nhận), có đồng ý của người cao tuổi, và lịch cũ chuyển RESCHEDULED
      // trong cùng một lần ghi để lịch sử luôn khớp.
      function rescheduleConfirmed() {
        let d = request.resource.data;
        let assignmentId = resource.data.currentAssignmentId;
        let next = schedulePath(assignmentId, d.scheduleId);
        let prev = schedulePath(assignmentId, resource.data.scheduleId);

        return resource.data.status == 'SCHEDULED'
          && d.status == 'SCHEDULED'
          && (
            isMember(resource.data.assignedOrgId)
            || hasRole(resource.data.recorderOrgId, 'RECORDER')
          )
          && d.scheduledByUid == request.auth.uid
          && d.scheduleId is string
          && d.scheduleId != resource.data.scheduleId
          && existsAfter(next)
          && getAfter(next).data.status == 'CONFIRMED'
          && getAfter(next).data.get('kind', '') == 'RESCHEDULE'
          && getAfter(next).data.replacesScheduleId == resource.data.scheduleId
          && getAfter(next).data.elderConsent == true
          && getAfter(prev).data.status == 'RESCHEDULED'
          && getAfter(prev).data.replacedById == d.scheduleId
          && d.scheduledAt == getAfter(next).data.startAt
          && d.scheduledEndAt == getAfter(next).data.endAt
          && d.scheduledFormat == getAfter(next).data.format
          && d.scheduledPlace == getAfter(next).data.place
          && d.rescheduleCount == resource.data.get('rescheduleCount', 0) + 1
          && d.rescheduledAt == request.time
          && changed().hasOnly([
            'scheduleId',
            'scheduledAt',
            'scheduledEndAt',
            'scheduledFormat',
            'scheduledPlace',
            'scheduledByUid',
            'rescheduleCount',
            'rescheduledAt',
            'updatedAt'
          ]);
      }

      function recorderConfirmsSchedule() {
        let d = request.resource.data;

        let schedule = schedulePath(
          resource.data.currentAssignmentId,
          d.scheduleId
        );

        return resource.data.status == 'ACCEPTED'
          && d.status == 'SCHEDULED'
          && hasRole(resource.data.recorderOrgId, 'RECORDER')
          && d.scheduledByUid == request.auth.uid
          && d.scheduleId is string
          && existsAfter(schedule)
          && getAfter(schedule).data.status == 'CONFIRMED'
          && getAfter(schedule).data.elderConsent == true
          && d.scheduledAt == getAfter(schedule).data.startAt
          && d.scheduledEndAt == getAfter(schedule).data.endAt
          && d.scheduledFormat == getAfter(schedule).data.format
          && d.scheduledPlace == getAfter(schedule).data.place
          && changed().hasOnly([
            'status',
            'scheduleId',
            'scheduledAt',
            'scheduledEndAt',
            'scheduledFormat',
            'scheduledPlace',
            'scheduledByUid',
            'updatedAt'
          ]);
      }

      function assignedOrgReportsDelivered() {
        let d = request.resource.data;

        return resource.data.status == 'SCHEDULED'
          && d.status == 'DELIVERED'
          && isMember(resource.data.assignedOrgId)
          && d.deliveredByUid == request.auth.uid
          && isText(d.deliveryReport, 5, 1000)
          && changed().hasOnly([
            'status',
            'deliveryReport',
            'deliveredByUid',
            'deliveredByName',
            'deliveredAt',
            'updatedAt'
          ]);
      }

      function recorderNotesReconcile() {
        let d = request.resource.data;

        return resource.data.status == 'DELIVERED'
          && d.status == 'DELIVERED'
          && hasRole(resource.data.recorderOrgId, 'RECORDER')
          && isText(d.reconcileNote, 1, 500)
          && changed().hasOnly([
            'reconcileNote',
            'reconcileAt',
            'updatedAt'
          ]);
      }

      function recorderCompletes() {
        let d = request.resource.data;

        return resource.data.status == 'DELIVERED'
          && d.status == 'COMPLETED'
          && hasRole(resource.data.recorderOrgId, 'RECORDER')
          && d.completedByUid == request.auth.uid
          && changed().hasOnly([
            'status',
            'completionNote',
            'completedByUid',
            'completedAt',
            'updatedAt'
          ]);
      }

      match /events/{eventId} {
        allow read: if canReadNeed(get(needPath(needId)).data);

        // Sự kiện ghi cùng lúc với thay đổi nhu cầu: chỉ đơn vị ghi nhận hoặc tổ chức phụ trách
        // (kể cả tổ chức vừa trả lại) được ghi, và toStatus phải khớp trạng thái sau khi ghi.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'type',
            'fromStatus',
            'toStatus',
            'byUid',
            'byName',
            'byOrgId',
            'note',
            'at'
          ])
          && isText(request.resource.data.type, 1, 40)
          && request.resource.data.byUid == request.auth.uid
          && isMember(request.resource.data.byOrgId)
          && request.resource.data.at == request.time
          && request.resource.data.toStatus == getAfter(needPath(needId)).data.status
          && (
            request.resource.data.byOrgId == getAfter(needPath(needId)).data.recorderOrgId
            || request.resource.data.byOrgId
              == getAfter(needPath(needId)).data.get('assignedOrgId', '-')
            || (
              exists(needPath(needId))
              && request.resource.data.byOrgId
                == get(needPath(needId)).data.get('assignedOrgId', '-')
            )
          );

        allow update, delete: if false;
      }
    }

    // ================================================================
    // THÔNG TIN RIÊNG CỦA NGƯỜI CAO TUỔI
    // ================================================================

    match /needs_private/{needId} {
      allow read: if signedIn()
        && (
          isMember(resource.data.recorderOrgId)
          || (
            get(needPath(needId)).data.assigneeUid == request.auth.uid
            && get(needPath(needId)).data.status
              in ['SCHEDULED', 'DELIVERED']
          )
        );

      allow create: if hasRole(
          request.resource.data.recorderOrgId,
          'RECORDER'
        )
        && existsAfter(needPath(needId))
        && getAfter(needPath(needId)).data.recorderOrgId
          == request.resource.data.recorderOrgId
        && request.resource.data.keys().hasOnly([
          'elderlyName',
          'contact',
          'address',
          'recorderOrgId',
          'updatedAt'
        ])
        && isText(request.resource.data.elderlyName, 2, 80)
        && isText(request.resource.data.contact, 1, 120);

      allow update: if hasRole(
          resource.data.recorderOrgId,
          'RECORDER'
        )
        && request.resource.data.recorderOrgId
          == resource.data.recorderOrgId
        && getAfter(needPath(needId)).data.status == 'REVIEW'
        && request.resource.data.keys().hasOnly([
          'elderlyName',
          'contact',
          'address',
          'recorderOrgId',
          'updatedAt'
        ])
        && isText(request.resource.data.elderlyName, 2, 80)
        && isText(request.resource.data.contact, 1, 120);

      allow delete: if false;
    }

    // ================================================================
    // LẦN TIẾP NHẬN, CHAT VÀ LỊCH
    // ================================================================

    match /needs_assignments/{assignmentId} {
      allow read: if isMember(resource.data.orgId)
        || isMember(resource.data.recorderOrgId);

      allow create: if hasRole(
          request.resource.data.orgId,
          'REPRESENTATIVE'
        )
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.acceptedByUid == request.auth.uid
        && getAfter(
          needPath(request.resource.data.needId)
        ).data.currentAssignmentId == assignmentId
        && getAfter(
          needPath(request.resource.data.needId)
        ).data.recorderOrgId == request.resource.data.recorderOrgId;

      allow update: if resource.data.status == 'ACTIVE'
        && changed().hasOnly([
          'status',
          'endReason',
          'endNote',
          'endedByUid',
          'endedAt'
        ])
        && request.resource.data.endedByUid == request.auth.uid
        && isText(request.resource.data.endReason, 1, 300)
        && (
          request.resource.data.get('endNote', null) == null
          || isText(request.resource.data.endNote, 1, 1000)
        )
        // Kết thúc lần tiếp nhận phải đi cùng thay đổi của nhu cầu trong cùng transaction,
        // không để lần tiếp nhận đóng mà nhu cầu vẫn trỏ tới nó.
        && (
          (
            request.resource.data.status == 'RETURNED'
            && hasRole(resource.data.orgId, 'REPRESENTATIVE')
            && getAfter(needPath(resource.data.needId)).data.status == 'OPEN'
            && getAfter(needPath(resource.data.needId)).data.currentAssignmentId == null
          )
          || (
            request.resource.data.status == 'CLOSED'
            && hasRole(resource.data.recorderOrgId, 'RECORDER')
            && getAfter(needPath(resource.data.needId)).data.status
              in ['CANCELLED', 'COMPLETED']
          )
        );

      allow delete: if false;

      // ================================================================
      // E09 · SOS: báo khẩn cho bên cùng phối hợp
      // ================================================================
      // Ứng dụng không phải dịch vụ cứu hộ: người dùng tự gọi 115 / 113 / 114 bằng trình quay số
      // của máy. Báo khẩn chỉ để người còn lại trong luồng chat (đầu mối ghi nhận / người được
      // giao) biết ngay và hỗ trợ liên hệ người nhà. Chỉ hai người đó đọc / ghi (R08); vị trí
      // (nếu gửi) chỉ hai người đó thấy; không sửa nội dung, không xóa (giữ để đối soát).
      match /sos/{alertId} {
        function sosParty() {
          let a = get(assignmentPath(assignmentId)).data;
          let n = get(needPath(a.needId)).data;
          return signedIn()
            && (request.auth.uid == a.assigneeUid || request.auth.uid == n.recorderUid);
        }

        function sosActive() {
          let a = get(assignmentPath(assignmentId)).data;
          let n = get(needPath(a.needId)).data;
          return a.status == 'ACTIVE'
            && n.status in ['ACCEPTED', 'SCHEDULED', 'DELIVERED']
            && n.currentAssignmentId == assignmentId;
        }

        allow read: if sosParty();

        allow create: if sosParty()
          && sosActive()
          && request.resource.data.keys().hasAll([
            'byUid', 'byName', 'kind', 'note', 'status', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'byUid', 'byName', 'kind', 'note', 'status', 'createdAt',
            'calledNumber', 'location', 'accuracyM'
          ])
          && request.resource.data.byUid == request.auth.uid
          && isText(request.resource.data.byName, 1, 80)
          && request.resource.data.kind in ['MEDICAL', 'SAFETY', 'FIRE', 'OTHER']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.status == 'OPEN'
          && request.resource.data.createdAt == request.time
          && (
            !('calledNumber' in request.resource.data)
            || request.resource.data.calledNumber in ['115', '113', '114']
          )
          && (
            !('location' in request.resource.data)
            || request.resource.data.location is latlng
          )
          && (
            !('accuracyM' in request.resource.data)
            || (
              request.resource.data.accuracyM is number
              && request.resource.data.accuracyM >= 0
              && request.resource.data.accuracyM <= 100000
            )
          );

        allow update: if sosParty()
          && (
            // Người còn lại xác nhận đã nhận báo khẩn
            (
              resource.data.status == 'OPEN'
              && request.resource.data.status == 'ACK'
              && request.auth.uid != resource.data.byUid
              && request.resource.data.ackByUid == request.auth.uid
              && isText(request.resource.data.ackByName, 1, 80)
              && request.resource.data.ackAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'ackByUid', 'ackByName', 'ackAt'])
            )
            // Một trong hai người ghi đã xử lý xong (kèm ghi chú ngắn)
            || (
              resource.data.status in ['OPEN', 'ACK']
              && request.resource.data.status == 'RESOLVED'
              && request.resource.data.resolvedByUid == request.auth.uid
              && isText(request.resource.data.resolvedByName, 1, 80)
              && request.resource.data.resolvedAt == request.time
              && request.resource.data.resolveNote is string
              && request.resource.data.resolveNote.size() <= 300
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'resolvedByUid', 'resolvedByName', 'resolvedAt', 'resolveNote'])
            )
          );

        allow delete: if false;
      }

      function assignment() {
        return get(assignmentPath(assignmentId)).data;
      }

      function needOfAssignment() {
        return get(needPath(assignment().needId)).data;
      }

      function assignmentActive() {
        return assignment().status == 'ACTIVE'
          && needOfAssignment().status
            in ['ACCEPTED', 'SCHEDULED', 'DELIVERED']
          && needOfAssignment().currentAssignmentId == assignmentId;
      }

      function chatMember() {
        return signedIn()
          && (
            request.auth.uid == assignment().assigneeUid
            || request.auth.uid == needOfAssignment().recorderUid
          );
      }

      // Người trong luồng chat và lần tiếp nhận còn hiệu lực; đọc mỗi document một lần để
      // không vượt giới hạn số lần get() của Security Rules khi ghi nhiều document một lúc
      function activeChatMember() {
        let a = get(assignmentPath(assignmentId)).data;
        let n = get(needPath(a.needId)).data;
        return signedIn()
          && (request.auth.uid == a.assigneeUid || request.auth.uid == n.recorderUid)
          && a.status == 'ACTIVE'
          && n.status in ['ACCEPTED', 'SCHEDULED', 'DELIVERED']
          && n.currentAssignmentId == assignmentId;
      }

      // Người kia trong luồng chat (để gọi điện, E06)
      function otherChatMember(uid) {
        let a = get(assignmentPath(assignmentId)).data;
        let n = get(needPath(a.needId)).data;
        return uid != request.auth.uid && (uid == a.assigneeUid || uid == n.recorderUid);
      }

      function attachmentPath(attachmentId) {
        return /databases/$(database)/documents/needs_assignments/$(assignmentId)/attachments/$(attachmentId);
      }

      // E06 · Tin văn bản (F11) giữ nguyên dạng cũ; có thể ghi type 'TEXT'
      function textMessage(d) {
        return d.keys().hasOnly(['senderUid', 'senderName', 'text', 'at', 'type'])
          && d.get('type', 'TEXT') == 'TEXT'
          && isText(d.text, 1, 1000);
      }

      // E06 · Tin ảnh / tệp: phải trỏ tới tệp đính kèm của chính người gửi trong cùng lần
      // tiếp nhận, khớp kích thước và kiểu tệp; chú thích (text) không bắt buộc
      function attachmentMessage(d) {
        let att = getAfter(attachmentPath(d.attachmentId)).data;
        return d.type in ['IMAGE', 'FILE']
          && d.keys().hasAll([
            'senderUid', 'senderName', 'text', 'at', 'type',
            'attachmentId', 'fileName', 'mimeType', 'size'
          ])
          && d.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'at', 'type',
            'attachmentId', 'fileName', 'mimeType', 'size', 'thumb'
          ])
          && d.text is string
          && d.text.size() <= 1000
          && d.attachmentId is string
          && isText(d.fileName, 1, 120)
          && isText(d.mimeType, 3, 100)
          && (d.type == 'FILE' || d.mimeType.matches('image/.*'))
          && (!('thumb' in d) || (d.thumb is bytes && d.thumb.size() <= 65536))
          && att.ownerUid == request.auth.uid
          && att.size == d.size
          && att.mimeType == d.mimeType
          && att.kind == d.type
          // Mảnh cuối đã lên máy chủ (ứng dụng tải mảnh theo thứ tự, tin nhắn gửi sau cùng)
          && existsAfter(chunkPath(d.attachmentId, att.chunkCount - 1));
      }

      function chunkPath(attachmentId, index) {
        return /databases/$(database)/documents/needs_assignments/$(assignmentId)/attachments/$(attachmentId)/chunks/$(string(index));
      }

      match /messages/{messageId} {
        allow read: if chatMember();

        allow create: if activeChatMember()
          && request.resource.data.senderUid == request.auth.uid
          && isText(request.resource.data.senderName, 1, 80)
          && request.resource.data.at == request.time
          && (
            textMessage(request.resource.data)
            || attachmentMessage(request.resource.data)
          );

        allow update, delete: if false;
      }

      // ================================================================
      // E06 · Ảnh / tệp gửi trong chat
      // ================================================================
      // Gói Firebase miễn phí của nhóm không dùng được Cloud Storage, nên tệp được chia thành
      // các mảnh tối đa 700 000 byte lưu trong Firestore (mỗi document tối đa 1 MiB). Mỗi mảnh
      // ghi trong một request riêng để không vượt giới hạn kích thước request. Chỉ hai người
      // trong luồng chat đọc được (R08); không sửa, không xóa; tối đa 5 MB / tệp.
      match /attachments/{attachmentId} {
        allow read: if chatMember();

        allow create: if activeChatMember()
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'fileName', 'mimeType', 'size', 'chunkCount', 'kind', 'createdAt'
          ])
          && request.resource.data.ownerUid == request.auth.uid
          && isText(request.resource.data.fileName, 1, 120)
          && isText(request.resource.data.mimeType, 3, 100)
          && request.resource.data.kind in ['IMAGE', 'FILE']
          && request.resource.data.size is int
          && request.resource.data.size > 0
          && request.resource.data.size <= 5242880
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount
            == math.ceil(request.resource.data.size / 700000.0)
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;

        match /chunks/{chunkId} {
          function chunkFits(att, d) {
            return att.ownerUid == request.auth.uid
              && d.keys().hasOnly(['index', 'data'])
              && d.index is int
              && d.index >= 0
              && d.index < att.chunkCount;
          }

          allow read: if chatMember();

          allow create: if activeChatMember()
            && chunkFits(getAfter(attachmentPath(attachmentId)).data, request.resource.data)
            && chunkId == string(request.resource.data.index)
            && request.resource.data.data is bytes
            && request.resource.data.data.size() > 0
            && request.resource.data.data.size() <= 700000;

          allow update, delete: if false;
        }
      }

      // ================================================================
      // E06 · Gọi thoại / video (WebRTC, trao đổi tín hiệu qua Firestore)
      // ================================================================
      // Chỉ hai người trong luồng chat gọi cho nhau, khi lần tiếp nhận còn hiệu lực.
      // Âm thanh / hình ảnh đi trực tiếp giữa hai máy, không lưu lại ở đâu.
      function validSdp(s, type) {
        return s is map
          && s.keys().hasOnly(['type', 'sdp'])
          && s.type == type
          && s.sdp is string
          && s.sdp.size() > 0
          && s.sdp.size() <= 20000;
      }

      match /calls/{callId} {
        allow read: if chatMember();

        allow create: if activeChatMember()
          && request.resource.data.keys().hasOnly([
            'callerUid', 'callerName', 'calleeUid', 'video', 'status', 'offer', 'createdAt'
          ])
          && request.resource.data.callerUid == request.auth.uid
          && isText(request.resource.data.callerName, 1, 80)
          && otherChatMember(request.resource.data.calleeUid)
          && request.resource.data.video is bool
          && request.resource.data.status == 'RINGING'
          && validSdp(request.resource.data.offer, 'offer')
          && request.resource.data.createdAt == request.time;

        function endFields() {
          return changed().hasOnly(['status', 'endedAt', 'endedByUid', 'durationSec'])
            && request.resource.data.endedByUid == request.auth.uid
            && request.resource.data.endedAt == request.time
            && (
              !('durationSec' in request.resource.data)
              || (
                request.resource.data.durationSec is int
                && request.resource.data.durationSec >= 0
                && request.resource.data.durationSec <= 86400
              )
            );
        }

        allow update: if chatMember()
          && (
            // Người được gọi nghe máy (lần tiếp nhận phải còn hiệu lực)
            (
              request.auth.uid == resource.data.calleeUid
              && resource.data.status == 'RINGING'
              && request.resource.data.status == 'ACCEPTED'
              && activeChatMember()
              && changed().hasOnly(['status', 'answer', 'answeredAt'])
              && validSdp(request.resource.data.answer, 'answer')
              && request.resource.data.answeredAt == request.time
            )
            // Người được gọi từ chối
            || (
              request.auth.uid == resource.data.calleeUid
              && resource.data.status == 'RINGING'
              && request.resource.data.status == 'DECLINED'
              && endFields()
            )
            // Người gọi hủy hoặc không ai nghe máy
            || (
              request.auth.uid == resource.data.callerUid
              && resource.data.status == 'RINGING'
              && request.resource.data.status in ['CANCELLED', 'MISSED']
              && endFields()
            )
            // Một trong hai bên kết thúc cuộc gọi đang diễn ra
            || (
              (
                request.auth.uid == resource.data.callerUid
                || request.auth.uid == resource.data.calleeUid
              )
              && resource.data.status == 'ACCEPTED'
              && request.resource.data.status == 'ENDED'
              && endFields()
            )
          );

        allow delete: if false;

        function callDoc() {
          return get(/databases/$(database)/documents/needs_assignments/$(assignmentId)/calls/$(callId)).data;
        }

        // Một trong hai bên của cuộc gọi đang đổ chuông hoặc đang diễn ra
        function callLive(c) {
          return callParty(c) && c.status in ['RINGING', 'ACCEPTED'];
        }

        function callParty(c) {
          return request.auth.uid == c.callerUid || request.auth.uid == c.calleeUid;
        }

        match /candidates/{candidateId} {
          allow read: if chatMember() && callParty(callDoc());

          allow create: if chatMember()
            && callLive(callDoc())
            && request.resource.data.keys().hasOnly(['fromUid', 'candidate', 'sdpMid', 'sdpMLineIndex', 'at'])
            && request.resource.data.fromUid == request.auth.uid
            && isText(request.resource.data.candidate, 1, 2000)
            && request.resource.data.sdpMid is string
            && request.resource.data.sdpMid.size() <= 64
            && request.resource.data.sdpMLineIndex is int
            && request.resource.data.at == request.time;

          allow update, delete: if false;
        }
      }

      match /schedules/{scheduleId} {
        allow read: if isMember(assignment().orgId)
          || isMember(assignment().recorderOrgId);

        function orgSide() {
          return hasRole(assignment().orgId, 'REPRESENTATIVE')
            || request.auth.uid == assignment().assigneeUid;
        }

        function recorderSide() {
          return hasRole(assignment().recorderOrgId, 'RECORDER');
        }

        // Khung giờ hợp lệ, dùng chung cho đề xuất đầu tiên (F12) và đổi lịch (E02)
        function validSlot(d) {
          return d.status == 'PROPOSED'
            && d.proposedByUid == request.auth.uid
            && isText(d.proposedByName, 1, 80)
            && d.startAt is timestamp
            && d.startAt > request.time
            && d.endAt is timestamp
            && d.endAt > d.startAt
            && d.endAt <= d.startAt + duration.value(12, 'h')
            && isText(d.format, 2, 120)
            && isText(d.place, 2, 200)
            && d.createdAt == request.time;
        }

        // E02 · Yêu cầu đổi lịch khi nhu cầu đã SCHEDULED. Bên nào đề xuất thì bên kia xác nhận.
        // Đầu mối đề xuất phải ghi sẵn đồng ý của người cao tuổi với giờ mới; tổ chức đề xuất
        // thì đầu mối hỏi ý kiến cụ lúc xác nhận.
        function reschedulePropose() {
          let d = request.resource.data;

          return assignmentActive()
            && needOfAssignment().status == 'SCHEDULED'
            && d.keys().hasAll([
              'startAt', 'endAt', 'format', 'place', 'status', 'proposedByUid',
              'proposedByName', 'createdAt', 'kind', 'replacesScheduleId',
              'proposedBySide', 'reason'
            ])
            && d.keys().hasOnly([
              'startAt', 'endAt', 'format', 'place', 'status', 'proposedByUid',
              'proposedByName', 'createdAt', 'kind', 'replacesScheduleId',
              'proposedBySide', 'reason', 'elderConsent', 'consentMethod'
            ])
            && d.kind == 'RESCHEDULE'
            && d.replacesScheduleId == needOfAssignment().scheduleId
            && isText(d.reason, 1, 300)
            && validSlot(d)
            && (
              (
                d.proposedBySide == 'ORG'
                && orgSide()
                && !('elderConsent' in d)
                && !('consentMethod' in d)
              )
              || (
                d.proposedBySide == 'RECORDER'
                && recorderSide()
                && d.elderConsent == true
                && isText(d.consentMethod, 1, 200)
              )
            );
        }

        allow create: if reschedulePropose() || (
          orgSide()
          && assignmentActive()
          && needOfAssignment().status == 'ACCEPTED'
          && request.resource.data.keys().hasAll([
            'startAt',
            'endAt',
            'format',
            'place',
            'status',
            'proposedByUid',
            'proposedByName',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'startAt',
            'endAt',
            'format',
            'place',
            'status',
            'proposedByUid',
            'proposedByName',
            'createdAt'
          ])
          && request.resource.data.status == 'PROPOSED'
          && request.resource.data.proposedByUid == request.auth.uid
          && request.resource.data.startAt is timestamp
          && request.resource.data.startAt > request.time
          && request.resource.data.endAt is timestamp
          && request.resource.data.endAt > request.resource.data.startAt
          && request.resource.data.endAt
            <= request.resource.data.startAt + duration.value(12, 'h')
          && isText(request.resource.data.format, 2, 120)
          && isText(request.resource.data.place, 2, 200)
          && request.resource.data.createdAt == request.time
        );

        // Đề xuất này do bên nào gửi; đề xuất F12 cũ không có trường này luôn là tổ chức
        function proposedBy(side) {
          return resource.data.get('proposedBySide', 'ORG') == side;
        }

        // Lịch được xác nhận phải đúng là lịch nhu cầu trỏ tới sau lần ghi này
        function becomesCurrentSchedule() {
          return getAfter(needPath(assignment().needId)).data.status == 'SCHEDULED'
            && getAfter(needPath(assignment().needId)).data.scheduleId == scheduleId;
        }

        allow update: if (resource.data.status == 'PROPOSED'
          && (
            (
              proposedBy('ORG')
              && recorderSide()
              && request.resource.data.decidedByUid == request.auth.uid
              && changed().hasOnly([
                'status',
                'elderConsent',
                'consentMethod',
                'declineReason',
                'decidedByUid',
                'decidedByName',
                'decidedAt'
              ])
              && (
                (
                  request.resource.data.status == 'CONFIRMED'
                  && request.resource.data.elderConsent == true
                  && isText(
                    request.resource.data.consentMethod,
                    1,
                    200
                  )
                  && becomesCurrentSchedule()
                )
                || (
                  request.resource.data.status == 'DECLINED'
                  && !('elderConsent' in request.resource.data)
                  && isText(
                    request.resource.data.declineReason,
                    1,
                    300
                  )
                )
              )
            )
            // E02 · Tổ chức trả lời yêu cầu đổi lịch do đầu mối gửi (đồng ý của cụ đã có sẵn)
            || (
              proposedBy('RECORDER')
              && orgSide()
              && request.resource.data.decidedByUid == request.auth.uid
              && changed().hasOnly([
                'status',
                'declineReason',
                'decidedByUid',
                'decidedByName',
                'decidedAt'
              ])
              && (
                (
                  request.resource.data.status == 'CONFIRMED'
                  && becomesCurrentSchedule()
                )
                || (
                  request.resource.data.status == 'DECLINED'
                  && isText(request.resource.data.declineReason, 1, 300)
                )
              )
            )
            // Rút lại đề xuất của chính bên mình (tổ chức: F12 và E02; đầu mối: E02)
            || (
              (
                (proposedBy('ORG') && isMember(assignment().orgId))
                || (proposedBy('RECORDER') && recorderSide())
              )
              && request.resource.data.status == 'WITHDRAWN'
              && changed().hasOnly([
                'status',
                'decidedByUid',
                'decidedByName',
                'decidedAt'
              ])
              && request.resource.data.decidedByUid == request.auth.uid
            )
          ))
          // E02 · Lịch đã chốt bị thay bằng lịch mới: chỉ đổi sang RESCHEDULED, giữ lại để xem lịch sử
          || (
            resource.data.status == 'CONFIRMED'
            && request.resource.data.status == 'RESCHEDULED'
            && (isMember(assignment().orgId) || recorderSide())
            && changed().hasOnly(['status', 'replacedById', 'rescheduledAt'])
            && request.resource.data.replacedById is string
            && request.resource.data.replacedById != scheduleId
            && request.resource.data.rescheduledAt == request.time
            && getAfter(needPath(assignment().needId)).data.scheduleId
              == request.resource.data.replacedById
            && getAfter(
              schedulePath(assignmentId, request.resource.data.replacedById)
            ).data.status == 'CONFIRMED'
          );

        allow delete: if false;
      }
    }

    // ================================================================
    // BỘ ĐẾM MÃ NHU CẦU
    // ================================================================

    // Bộ đếm chỉ tăng khi đầu mối tạo nhu cầu mới trong cùng transaction (lastNeedId).
    function counterBumpedByRecorder() {
      let d = request.resource.data;

      return d.keys().hasOnly(['next', 'lastNeedId'])
        && d.lastNeedId is string
        && !exists(needPath(d.lastNeedId))
        && existsAfter(needPath(d.lastNeedId))
        && hasRole(getAfter(needPath(d.lastNeedId)).data.recorderOrgId, 'RECORDER');
    }

    match /counters/needs {
      allow read: if signedIn();

      allow create: if counterBumpedByRecorder()
        && request.resource.data.next == 2;

      allow update: if counterBumpedByRecorder()
        && request.resource.data.next == resource.data.next + 1;
    }

    // ================================================================
    // BẢNG TIN (F04, F05)
    // ================================================================

    // F04, F05 · Bảng tin. Tài khoản đã đăng nhập đọc được bài chưa ẩn (truy vấn danh sách
    // phải có whereEqualTo("hidden", false)); thành viên tổ chức xem được cả bài đã ẩn của mình.
    // Chỉ đại diện của tổ chức đăng, sửa, ẩn bài của tổ chức đó; không xóa bài.
    match /posts/{postId} {
      function orgPath(orgId) {
        return /databases/$(database)/documents/organizations/$(orgId);
      }

      // Ô không bắt buộc: không có, null, hoặc chuỗi 1..maxLen ký tự
      function optionalText(d, key, maxLen) {
        return !(key in d) || d[key] == null || isText(d[key], 1, maxLen);
      }

      function validPost(d) {
        return isText(d.title, 5, 120)
          && isText(d.content, 10, 2000)
          && optionalText(d, 'eventTime', 120)
          && optionalText(d, 'eventPlace', 120);
      }

      allow read: if signedIn()
        && (resource.data.hidden == false || isMember(resource.data.orgId));

      // Tích "đã xác minh" phải khớp organizations/{orgId}.verified, không tự gắn được
      allow create: if hasRole(request.resource.data.orgId, 'REPRESENTATIVE')
        && request.resource.data.keys().hasOnly(['title', 'content', 'orgId', 'orgName', 'orgVerified',
             'authorUid', 'authorName', 'hidden', 'createdAt', 'updatedAt',
             'eventTime', 'eventPlace'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.hidden == false
        && request.resource.data.orgVerified is bool
        && (request.resource.data.orgVerified == false
            || get(orgPath(request.resource.data.orgId)).data.get('verified', false) == true)
        && validPost(request.resource.data)
        && request.resource.data.createdAt == request.time;

      // Sửa nội dung hoặc ẩn bài; không đổi tổ chức, người đăng, thời điểm đăng
      allow update: if hasRole(resource.data.orgId, 'REPRESENTATIVE')
        && changed().hasOnly(['title', 'content', 'hidden', 'updatedAt', 'eventTime', 'eventPlace'])
        && request.resource.data.hidden is bool
        && validPost(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ================================================================
    // E03 · ĐÁNH GIÁ SAU HỖ TRỢ VÀ XỬ LÝ PHẢN ÁNH
    // ================================================================

    // Đánh giá tổ chức sau khi nhu cầu hoàn thành. Id tài liệu = id lần tiếp nhận, nên mỗi lần
    // hỗ trợ chỉ đánh giá một lần. Chỉ đầu mối của đơn vị ghi nhận gửi; không sửa, không xóa.
    // Không hiện trên bảng tin: chỉ hai bên của lần tiếp nhận đọc được.
    match /org_ratings/{assignmentId} {
      // resource == null: cho phép kiểm tra "đã đánh giá chưa" trước khi gửi
      allow read: if signedIn()
        && (resource == null
          || isMember(resource.data.recorderOrgId)
          || isMember(resource.data.orgId));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['needId', 'caseCode', 'recorderOrgId', 'orgId',
             'orgName', 'assigneeName', 'stars', 'tags', 'comment', 'elderAsked',
             'byUid', 'byName', 'createdAt'])
        && ratingMatchesNeed(request.resource.data, get(needPath(request.resource.data.needId)).data)
        && hasRole(request.resource.data.recorderOrgId, 'RECORDER')
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.elderAsked == true
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 6
        && (request.resource.data.comment == null || isText(request.resource.data.comment, 1, 500))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      function ratingMatchesNeed(d, need) {
        return need.status == 'COMPLETED'
          && need.currentAssignmentId == assignmentId
          && d.orgId == need.assignedOrgId
          && d.recorderOrgId == need.recorderOrgId;
      }
    }

    // Phản ánh về một lần hỗ trợ. Người gửi là thành viên của một trong hai bên (đơn vị ghi nhận
    // hoặc tổ chức tiếp nhận), phản ánh luôn nói về bên còn lại. Điều phối viên (REVIEWER) của đơn vị
    // ghi nhận xử lý: OPEN → IN_PROGRESS → CLOSED, không tự xử lý phản ánh của chính mình.
    // Tổ chức bị phản ánh chỉ đọc được khi phản ánh đã được tiếp nhận xử lý.
    function reportPath(reportId) {
      return /databases/$(database)/documents/feedback_reports/$(reportId);
    }

    function reportReviewer(r) {
      return hasRole(r.recorderOrgId, 'REVIEWER') && request.auth.uid != r.createdByUid;
    }

    function canReadReport(r) {
      return signedIn()
        && (r.createdByUid == request.auth.uid
          || hasRole(r.recorderOrgId, 'REVIEWER')
          || (r.status != 'OPEN' && isMember(r.reportedOrgId)));
    }

    match /feedback_reports/{reportId} {
      allow read: if canReadReport(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['needId', 'caseCode', 'assignmentId', 'recorderOrgId',
             'reporterOrgId', 'reportedOrgId', 'reportedOrgName', 'type', 'description', 'status',
             'createdByUid', 'createdByName', 'createdAt', 'updatedAt'])
        && reportMatchesAssignment(request.resource.data, get(assignmentPath(request.resource.data.assignmentId)).data)
        && request.resource.data.type in ['LATE', 'ATTITUDE', 'PRIVACY', 'OTHER']
        && isText(request.resource.data.description, 10, 1000)
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if reportReviewer(resource.data)
        && request.resource.data.updatedAt == request.time
        && (reviewerStarts() || reviewerCloses());

      allow delete: if false;

      function reportMatchesAssignment(d, a) {
        return a.needId == d.needId
          && d.recorderOrgId == a.recorderOrgId
          && (
            (isMember(a.recorderOrgId) && d.reporterOrgId == a.recorderOrgId && d.reportedOrgId == a.orgId)
            || (isMember(a.orgId) && d.reporterOrgId == a.orgId && d.reportedOrgId == a.recorderOrgId)
          );
      }

      function reviewerStarts() {
        return resource.data.status == 'OPEN'
          && request.resource.data.status == 'IN_PROGRESS'
          && request.resource.data.handlerUid == request.auth.uid
          && changed().hasOnly(['status', 'handlerUid', 'handlerName', 'updatedAt']);
      }

      function reviewerCloses() {
        return resource.data.status == 'IN_PROGRESS'
          && request.resource.data.status == 'CLOSED'
          && isText(request.resource.data.resolution, 5, 1000)
          && request.resource.data.closedAt == request.time
          && changed().hasOnly(['status', 'resolution', 'closedAt', 'updatedAt']);
      }

      // Quá trình xử lý: chỉ thêm, không sửa / xóa.
      match /notes/{noteId} {
        allow read: if canReadReport(get(reportPath(reportId)).data);

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['kind', 'text', 'byUid', 'byName', 'byRole', 'at'])
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.at == request.time
          && isText(request.resource.data.text, 1, 1000)
          && noteAllowed(request.resource.data, get(reportPath(reportId)).data,
               getAfter(reportPath(reportId)).data);

        allow update, delete: if false;

        function noteAllowed(n, prevReport, nextReport) {
          return (n.kind == 'START' && n.byRole == 'REVIEWER' && reportReviewer(prevReport)
              && prevReport.status == 'OPEN' && nextReport.status == 'IN_PROGRESS')
            || (n.kind == 'ASK' && n.byRole == 'REVIEWER' && reportReviewer(prevReport)
              && prevReport.status == 'IN_PROGRESS')
            || (n.kind == 'INFO' && n.byRole == 'REPORTER' && prevReport.createdByUid == request.auth.uid
              && prevReport.status != 'CLOSED')
            || (n.kind == 'CLOSE' && n.byRole == 'REVIEWER' && reportReviewer(prevReport)
              && prevReport.status == 'IN_PROGRESS' && nextReport.status == 'CLOSED');
        }
      }
    }

    // ================================================================
    // E07 · NHÓM VÀ SỰ KIỆN CỘNG ĐỒNG
    // ================================================================

    // Sự kiện do đại diện tổ chức tạo; tài khoản đã đăng nhập xem được. Mỗi tổ chức đăng ký một
    // phiếu registrations/{orgId} (số thành viên tham gia). registeredCount trên sự kiện luôn khớp
    // tổng số người: chỉ đổi cùng lúc với phiếu đăng ký (transaction) và không vượt sức chứa.
    function eventPath(eventId) {
      return /databases/$(database)/documents/community_events/$(eventId);
    }

    function registrationPath(eventId, orgId) {
      return /databases/$(database)/documents/community_events/$(eventId)/registrations/$(orgId);
    }

    match /community_events/{eventId} {
      allow read: if signedIn();

      allow create: if hasRole(request.resource.data.orgId, 'REPRESENTATIVE')
        && request.resource.data.keys().hasOnly(['title', 'content', 'place', 'area', 'orgId', 'orgName',
             'createdByUid', 'createdByName', 'startAt', 'endAt', 'capacity', 'registeredCount',
             'allowCancel', 'openToOtherOrgs', 'cancelled', 'createdAt', 'updatedAt'])
        && request.resource.data.createdByUid == request.auth.uid
        && isText(request.resource.data.title, 5, 120)
        && isText(request.resource.data.content, 10, 2000)
        && isText(request.resource.data.place, 2, 160)
        && isText(request.resource.data.area, 0, 120)
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.startAt > request.time
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 500
        && request.resource.data.registeredCount == 0
        && request.resource.data.allowCancel is bool
        && request.resource.data.openToOtherOrgs is bool
        && request.resource.data.cancelled == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Tổ chức tạo sự kiện hủy sự kiện (không mở lại được), hoặc cập nhật số người cùng phiếu đăng ký
      allow update: if organizerCancels() || counterFollowsRegistration();

      allow delete: if false;

      function organizerCancels() {
        return hasRole(resource.data.orgId, 'REPRESENTATIVE')
          && resource.data.cancelled == false
          && request.resource.data.cancelled == true
          && request.resource.data.updatedAt == request.time
          && changed().hasOnly(['cancelled', 'updatedAt']);
      }

      function peopleBefore(orgId) {
        return exists(registrationPath(eventId, orgId))
          ? get(registrationPath(eventId, orgId)).data.people : 0;
      }

      function peopleAfter(orgId) {
        return existsAfter(registrationPath(eventId, orgId))
          ? getAfter(registrationPath(eventId, orgId)).data.people : 0;
      }

      function counterFollowsRegistration() {
        let org = request.resource.data.lastRegOrgId;
        let prevPeople = peopleBefore(org);
        let nextPeople = peopleAfter(org);
        return changed().hasOnly(['registeredCount', 'lastRegOrgId'])
          && org is string
          && hasRole(org, 'REPRESENTATIVE')
          && request.resource.data.registeredCount == resource.data.registeredCount - prevPeople + nextPeople
          && (nextPeople <= prevPeople || request.resource.data.registeredCount <= resource.data.capacity);
      }

      match /registrations/{orgId} {
        allow read: if signedIn();

        allow create: if hasRole(orgId, 'REPRESENTATIVE')
          && request.resource.data.keys().hasOnly(['orgName', 'people', 'byUid', 'byName', 'createdAt', 'updatedAt'])
          && request.resource.data.byUid == request.auth.uid
          && validPeople(request.resource.data.people)
          && eventOpenFor(get(eventPath(eventId)).data)
          && counterMatches(0, request.resource.data.people)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if hasRole(orgId, 'REPRESENTATIVE')
          && changed().hasOnly(['people', 'byUid', 'byName', 'updatedAt'])
          && request.resource.data.byUid == request.auth.uid
          && validPeople(request.resource.data.people)
          && eventOpenFor(get(eventPath(eventId)).data)
          && (request.resource.data.people >= resource.data.people
            || beforeCancelDeadline(get(eventPath(eventId)).data))
          && counterMatches(resource.data.people, request.resource.data.people)
          && request.resource.data.updatedAt == request.time;

        // Hủy tham gia: sự kiện cho hủy và còn ít nhất 24 giờ trước giờ bắt đầu
        allow delete: if hasRole(orgId, 'REPRESENTATIVE')
          && beforeCancelDeadline(get(eventPath(eventId)).data)
          && counterMatches(resource.data.people, 0);

        function validPeople(p) {
          return p is int && p >= 1 && p <= 20;
        }

        function eventOpenFor(ev) {
          return ev.cancelled == false
            && ev.startAt > request.time
            && (ev.openToOtherOrgs == true || ev.orgId == orgId);
        }

        function beforeCancelDeadline(ev) {
          return ev.allowCancel == true
            && request.time < ev.startAt - duration.value(24, 'h');
        }

        // Sự kiện phải được cập nhật trong cùng transaction: số người đổi đúng bằng phần chênh lệch
        function counterMatches(oldPeople, newPeople) {
          let ev = get(eventPath(eventId)).data;
          let evAfter = getAfter(eventPath(eventId)).data;
          return evAfter.registeredCount == ev.registeredCount - oldPeople + newPeople
            && evAfter.lastRegOrgId == orgId
            && (newPeople <= oldPeople || evAfter.registeredCount <= ev.capacity);
        }
      }
    }

    // ================================================================
    // MẶC ĐỊNH TỪ CHỐI
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}