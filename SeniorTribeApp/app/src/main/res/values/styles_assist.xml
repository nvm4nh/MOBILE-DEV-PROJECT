<?xml version="1.0" encoding="utf-8"?>
<!-- E04, E05 · Kiểu dùng cho nhập giọng nói và trợ lý -->
<resources>
    <style name="Assist" />

    <!-- Nút dạng viên thuốc có biểu tượng: "Nói để nhập nội dung", "Nhờ trợ lý viết lại" -->
    <style name="Assist.ActionChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="chipIconTint">@color/primary</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipMinHeight">40dp</item>
    </style>

    <!-- Câu hỏi gợi ý trong màn hình trợ lý -->
    <style name="Assist.SuggestChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="chipMinHeight">40dp</item>
    </style>

    <style name="Assist.BubbleText">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
