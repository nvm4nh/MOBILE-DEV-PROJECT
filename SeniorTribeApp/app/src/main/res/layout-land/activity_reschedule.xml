<?xml version="1.0" encoding="utf-8"?>
<!-- E02 · Đổi lịch, bố cục ngang hai cột: trái là lịch đang hẹn, yêu cầu đang chờ và lịch sử;
     phải là form đề xuất giờ mới. Cùng id với bản dọc nên Activity không cần xử lý riêng. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/resched_title" />

    <include layout="@layout/include_coord_header" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBusy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/frameContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <include layout="@layout/include_reschedule_status" />

                    <include layout="@layout/include_reschedule_history" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <include layout="@layout/include_reschedule_form" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/view_list_state" />
    </FrameLayout>

    <include layout="@layout/include_bottom_actions" />
</LinearLayout>
