<?xml version="1.0" encoding="utf-8"?>
<!-- F12, F13 · Dải dưới thanh tiêu đề: chip trạng thái + một dòng thông tin
     ("Đại diện: Nguyễn Minh Khoa" hoặc "Cập nhật 19/10 · 16:20"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCoordHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvHeaderStatus"
        style="@style/Needs.StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Đã tiếp nhận" />

    <TextView
        android:id="@+id/tvHeaderMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="Đại diện: Nguyễn Minh Khoa" />
</LinearLayout>
