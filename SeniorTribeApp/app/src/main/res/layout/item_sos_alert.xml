<?xml version="1.0" encoding="utf-8"?>
<!-- E09 · Một báo khẩn: loại, người báo, giờ, ghi chú, vị trí và nút xác nhận / xử lý xong. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Needs.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAlertStatus"
            style="@style/Needs.StatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Chưa ai nhận" />

        <TextView
            android:id="@+id/tvAlertTitle"
            style="@style/Needs.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            tools:text="Sức khỏe · Nguyễn Minh Khoa · 14:32" />

        <TextView
            android:id="@+id/tvAlertNote"
            style="@style/Needs.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Cụ khó thở, đã gọi 115." />

        <TextView
            android:id="@+id/tvAlertMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            tools:text="Đã gọi 115 · Trần Thị Mai đã nhận 14:33" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlertMap"
                style="@style/Needs.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_view_location"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlertAck"
                style="@style/Needs.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_ack"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlertResolve"
                style="@style/Needs.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_resolve"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
