<?xml version="1.0" encoding="utf-8"?>
<!-- F13 · Một bước trên dòng tiến độ: chấm trạng thái + đường nối bên trái, tên bước và mô tả bên phải. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:importantForAccessibility="yes"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStep"
            android:layout_width="@dimen/step_indicator"
            android:layout_height="@dimen/step_indicator"
            android:importantForAccessibility="no"
            android:padding="4dp"
            tools:background="@drawable/bg_step_done"
            tools:src="@drawable/ic_check" />

        <View
            android:id="@+id/viewStepLine"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:background="@color/divider"
            android:minHeight="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/step_indicator"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Đã tiếp nhận" />

        <TextView
            android:id="@+id/tvStepDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Đoàn TN Phường 7 · 11/10" />
    </LinearLayout>
</LinearLayout>
