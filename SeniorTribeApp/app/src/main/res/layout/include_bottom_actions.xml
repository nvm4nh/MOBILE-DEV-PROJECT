<?xml version="1.0" encoding="utf-8"?>
<!-- F12, F13 · Hai nút cố định ở cuối màn hình (ví dụ "Đổi giờ khác" / "Chốt lịch"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutActions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSecondary"
        style="@style/Needs.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Đổi giờ khác" />

    <Space
        android:id="@+id/spaceActions"
        android:layout_width="12dp"
        android:layout_height="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimary"
        style="@style/Needs.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Chốt lịch" />
</LinearLayout>
