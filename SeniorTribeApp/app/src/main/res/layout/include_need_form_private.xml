<?xml version="1.0" encoding="utf-8"?>
<!-- F06 · Phần "Thông tin riêng": lưu tách sang needs_private, không hiện trong danh sách. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Needs.Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_lock"
        android:text="@string/form_section_private" />

    <TextView
        style="@style/Needs.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/form_private_helper" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Needs.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etElderlyName"
                android:text="@string/form_elderly_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilElderlyName"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:placeholderText="@string/form_elderly_name_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etElderlyName"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="80" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etContact"
                android:text="@string/form_contact" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContact"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:placeholderText="@string/form_contact_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContact"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etAddress"
                android:text="@string/form_address" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddress"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:placeholderText="@string/form_address_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress|textCapWords"
                    android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
