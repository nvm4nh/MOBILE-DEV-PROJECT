<?xml version="1.0" encoding="utf-8"?>
<!-- F15 · Một lịch hẹn: ô giờ bên trái (bắt đầu / kết thúc), bên phải tên việc · khu vực,
     người phụ trách và trạng thái (Figma "Lịch"). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Needs.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layoutTimeCell"
            android:layout_width="@dimen/time_cell_width"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_time_cell"
            android:gravity="center"
            android:minHeight="64dp"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="14:00" />

            <TextView
                android:id="@+id/tvEndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="16:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvScheduleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Trò chuyện với cụ bà · Phường 7" />

            <TextView
                android:id="@+id/tvScheduleAssignee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Phụ trách: Nguyễn Minh Khoa" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Needs.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="Đã hẹn lịch" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
