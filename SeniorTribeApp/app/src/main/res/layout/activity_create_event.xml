<?xml version="1.0" encoding="utf-8"?>
<!-- E07 · Tạo sự kiện (đại diện tổ chức). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCreateEvent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/create_event_title"
        app:titleTextColor="@color/text_primary" />

    <FrameLayout
        android:id="@+id/frameCreateEvent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollCreateEvent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <!-- Đăng với tư cách -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Needs.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvAsAvatar"
                            style="@style/Post.Avatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            tools:text="CT" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Needs.Text.Meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/create_event_as" />

                            <TextView
                                android:id="@+id/tvAsOrg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Hội CTĐ Quận 3" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Needs.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etEventName"
                    android:text="@string/create_event_name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEventName"
                    style="@style/Needs.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="120"
                    app:placeholderText="@string/create_event_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEventName"
                        style="@style/Needs.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="120" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Needs.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_date" />

                        <TextView
                            android:id="@+id/tvEventDate"
                            style="@style/Needs.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:drawableEnd="@drawable/ic_event"
                            android:focusable="true"
                            android:hint="@string/create_event_pick_date" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Needs.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_time" />

                        <TextView
                            android:id="@+id/tvEventTime"
                            style="@style/Needs.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:drawableEnd="@drawable/ic_time"
                            android:focusable="true"
                            android:hint="@string/create_event_pick_time" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTimeError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:textColor="@color/error"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Giờ kết thúc phải sau giờ bắt đầu."
                    tools:visibility="visible" />

                <TextView
                    style="@style/Needs.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/etEventPlace"
                    android:text="@string/create_event_place" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEventPlace"
                    style="@style/Needs.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:placeholderText="@string/create_event_place_hint"
                    app:startIconDrawable="@drawable/ic_place">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEventPlace"
                        style="@style/Needs.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="160" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Needs.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/etEventArea"
                    android:text="@string/create_event_area" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEventArea"
                    style="@style/Needs.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:placeholderText="@string/create_event_area_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEventArea"
                        style="@style/Needs.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="120" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Số chỗ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_capacity"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Needs.Text.Meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_capacity_note" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCapacityMinus"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/event_people_minus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_remove"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/primary" />

                    <TextView
                        android:id="@+id/tvCapacity"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="40" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCapacityPlus"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/event_people_plus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/primary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAllowCancel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/create_event_allow_cancel"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swOpenOthers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/create_event_open"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Needs.Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_event_open_note" />

                <TextView
                    style="@style/Needs.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etEventContent"
                    android:text="@string/create_event_content" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEventContent"
                    style="@style/Needs.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="2000"
                    app:placeholderText="@string/create_event_content_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEventContent"
                        style="@style/Needs.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="2000"
                        android:minLines="4" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Needs.Note.Warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_shield"
                    android:text="@string/create_event_privacy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitEvent"
                    style="@style/Needs.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/create_event_submit" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
