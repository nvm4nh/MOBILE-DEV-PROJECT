<?xml version="1.0" encoding="utf-8"?>
<!-- F11 · Dải dưới thanh tiêu đề: trạng thái nhu cầu, hai đơn vị đang phối hợp và lối tắt
     sang bước tiếp theo (Thống nhất lịch / Tiến độ). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutChatHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvChatStatus"
        style="@style/Needs.StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Đã tiếp nhận" />

    <TextView
        android:id="@+id/tvChatOrgs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Hội CTĐ Quận 3 · Đoàn TN Phường 7" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChatNextStep"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Lịch hẹn"
        tools:visibility="visible" />
</LinearLayout>
