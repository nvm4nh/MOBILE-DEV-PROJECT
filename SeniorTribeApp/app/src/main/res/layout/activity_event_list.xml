<?xml version="1.0" encoding="utf-8"?>
<!-- E07 · Sự kiện cộng đồng sắp diễn ra; đại diện tổ chức tạo sự kiện bằng nút nổi. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootEventList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/events_title"
            app:titleTextColor="@color/text_primary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            app:checkedChip="@id/chipEventsAll"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEventsAll"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/events_chip_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEventsMine"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/events_chip_mine" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tvEventsOffline"
            style="@style/Needs.Note.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:drawableStart="@drawable/ic_warning"
            android:text="@string/events_offline"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/frameEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="96dp" />

            <include layout="@layout/view_list_state" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/events_fab_create"
        android:textColor="@color/on_primary"
        android:visibility="gone"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
