<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Bảng tin (F04) với các trạng thái F16: đang tải, rỗng, lỗi, offline (xem bài đã tải từ SQLite). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tiêu đề tab như Figma F04 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/Needs.Text.ScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/nav_feed" />
        </LinearLayout>

        <!-- F04 · Lọc "Tất cả" / "Đơn vị của tôi" như Figma -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:checkedChip="@id/chipFeedAll"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFeedAll"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feed_chip_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFeedMyOrg"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feed_chip_my_org" />
        </com.google.android.material.chip.ChipGroup>

        <!-- F16 · Offline: đang xem bài đã lưu trong SQLite -->
        <TextView
            android:id="@+id/tvOfflineNotice"
            style="@style/Needs.Note.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:drawableStart="@drawable/ic_cloud_off"
            android:text="@string/feed_offline_notice"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPosts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="96dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Đang tải / rỗng / lỗi / offline chưa có bài (dùng chung với tab Nhu cầu) -->
            <include layout="@layout/view_list_state" />
        </FrameLayout>
    </LinearLayout>

    <!-- Chỉ hiện cho đại diện tổ chức khi đang có mạng -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreatePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/btn_create_post"
        android:textColor="@color/on_primary"
        android:visibility="gone"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
