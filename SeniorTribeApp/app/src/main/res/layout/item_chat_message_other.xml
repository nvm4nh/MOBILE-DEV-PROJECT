<?xml version="1.0" encoding="utf-8"?>
<!-- F11 · Tin của bên kia: "Tên · Đầu mối", bong bóng trắng, giờ gửi (Figma). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingEnd="48dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Trần Thị Mai · Đầu mối" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_other"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="15sp"
        tools:text="Chào em, cụ thích nghe cải lương và hay kể chuyện ngày xưa." />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        tools:text="10:12" />
</LinearLayout>
