<?xml version="1.0" encoding="utf-8"?>
<!-- F11 · Tin của bên kia: "Tên · Đầu mối", bong bóng trắng, giờ gửi (Figma). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingEnd="48dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Trần Thị Mai · Đầu mối" />

    <!-- E06 · Ảnh (ảnh nhỏ, bấm để xem lớn) hoặc tệp đính kèm -->
    <ImageView
        android:id="@+id/ivAttachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_chat_attachment"
        android:clipToOutline="true"
        android:maxWidth="240dp"
        android:maxHeight="280dp"
        android:minWidth="120dp"
        android:minHeight="90dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_chat_attachment"
        android:gravity="center_vertical"
        android:maxWidth="260dp"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_file"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxWidth="190dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="giay-hen-tai-kham.pdf" />

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="PDF · 240 KB" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_other"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="15sp"
        tools:text="Chào em, cụ thích nghe cải lương và hay kể chuyện ngày xưa." />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        tools:text="10:12" />
</LinearLayout>
