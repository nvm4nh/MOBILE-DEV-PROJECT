<?xml version="1.0" encoding="utf-8"?>
<!-- F13 · Tiêu đề nhu cầu và dòng tiến độ 5 bước:
     Đã tiếp nhận → Đã hẹn lịch → Tổ chức báo đã hỗ trợ → Đầu mối đối soát → Hoàn thành. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvNeedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold"
        tools:text="Trò chuyện cuối tuần với cụ bà sống một mình" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Needs.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/layoutSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvClosedNote"
        style="@style/Needs.Note.Neutral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:text="Nhu cầu đã bị hủy." />
</LinearLayout>
