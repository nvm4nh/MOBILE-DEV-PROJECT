<?xml version="1.0" encoding="utf-8"?>
<!-- F12 · "Đề xuất của tổ chức": Ngày, Khung giờ, Hình thức (Figma).
     Tổ chức phụ trách bấm vào Ngày / Khung giờ để chọn và gõ Hình thức; các vai trò khác chỉ xem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutProposal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Needs.Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityHeading="true"
        android:drawableStart="@drawable/ic_schedule"
        android:text="@string/agree_section_proposal" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Needs.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/tvDate"
                android:text="@string/agree_label_date" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/Needs.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/agree_pick_date"
                tools:text="Thứ 7, 19/10/2026" />

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/tvTimeRange"
                android:text="@string/agree_label_time" />

            <TextView
                android:id="@+id/tvTimeRange"
                style="@style/Needs.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/agree_pick_time"
                tools:text="14:00 – 16:00" />

            <TextView
                android:id="@+id/tvTimeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/error"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Giờ kết thúc phải sau giờ bắt đầu." />

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etFormat"
                android:text="@string/agree_label_format" />

            <!-- Hình thức: ô nhập khi tổ chức soạn đề xuất -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFormat"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:placeholderText="@string/agree_format_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormat"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hình thức: chỉ xem -->
            <TextView
                android:id="@+id/tvFormat"
                style="@style/Needs.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Đến nhà · 2 đoàn viên"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvProposedBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Nguyễn Minh Khoa đề xuất · 10:24 18/10/2026"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvProposalNote"
        style="@style/Needs.Note.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:text="Đang chờ đầu mối hỏi ý kiến cụ."
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvDeclinedNote"
        style="@style/Needs.Note.Warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:text="Đề xuất trước bị từ chối: cụ bận buổi sáng."
        tools:visibility="visible" />
</LinearLayout>
