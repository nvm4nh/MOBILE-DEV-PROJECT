<?xml version="1.0" encoding="utf-8"?>
<!-- E04 · Nói để nhập nội dung, E05 · Nhờ trợ lý viết lại. Đặt ngay dưới ô Nội dung nhu cầu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutContentAssist"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvVoiceInserted"
        style="@style/Needs.Note.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/ic_mic"
        android:drawableTint="@color/primary"
        android:text="@string/voice_inserted_note"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupContentAssist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:chipSpacingHorizontal="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVoiceInput"
            style="@style/Assist.ActionChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_action_speak"
            app:chipIcon="@drawable/ic_mic" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUndoVoice"
            style="@style/Assist.ActionChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_action_undo"
            android:visibility="gone"
            app:chipIcon="@drawable/ic_undo"
            tools:visibility="visible" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAiRewrite"
            style="@style/Assist.ActionChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_action_rewrite"
            app:chipIcon="@drawable/ic_sparkles" />
    </com.google.android.material.chip.ChipGroup>

    <!-- E05 · Thẻ gợi ý của trợ lý -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiSuggestion"
        style="@style/Needs.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:strokeColor="@color/primary"
        app:strokeWidth="1.5dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_assist_icon"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/ai_suggestion_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAiSuggestion"
                style="@style/Assist.BubbleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textIsSelectable="true"
                tools:text="Cụ ông sống một mình, mong có người đến trò chuyện cùng cụ khoảng 2 giờ mỗi tuần." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/layoutAiChanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiSkip"
                    style="@style/Needs.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_skip" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiUse"
                    style="@style/Needs.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/ai_use" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvAiDisclaimer"
        style="@style/Needs.Note.Neutral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_shield"
        android:text="@string/ai_disclaimer"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
