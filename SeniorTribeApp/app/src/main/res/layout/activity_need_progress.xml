<?xml version="1.0" encoding="utf-8"?>
<!-- F13 · Tiến độ & đối soát kết quả (Figma "Tiến độ · NC-0142"): dòng tiến độ 5 bước,
     kết quả tổ chức báo, ô đối soát và hai nút "Chưa khớp" / "Hoàn thành". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/progress_title" />

    <include layout="@layout/include_coord_header" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBusy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/frameContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <include layout="@layout/include_progress_steps" />

                <include layout="@layout/include_progress_actions" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/view_list_state" />
    </FrameLayout>

    <include layout="@layout/include_bottom_actions" />
</LinearLayout>
