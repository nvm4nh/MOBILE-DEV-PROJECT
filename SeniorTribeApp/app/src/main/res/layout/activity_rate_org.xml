<?xml version="1.0" encoding="utf-8"?>
<!-- E03 · Đánh giá tổ chức sau khi nhu cầu hoàn thành (đầu mối ghi nhận, theo ý kiến của cụ). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRateOrg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/rate_title_plain"
        app:titleTextColor="@color/text_primary" />

    <FrameLayout
        android:id="@+id/frameRate"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollRate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRateStatus"
                        style="@style/Needs.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Hoàn thành" />

                    <TextView
                        android:id="@+id/tvCompletedOn"
                        style="@style/Needs.Text.Meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        tools:text="Hoàn thành 19/10/2026" />
                </LinearLayout>

                <!-- Tổ chức được đánh giá -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Needs.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvOrgAvatar"
                            style="@style/Post.Avatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            tools:text="ĐT" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOrgName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="Đoàn TN Phường 7" />

                            <TextView
                                android:id="@+id/tvAssignee"
                                style="@style/Needs.Text.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="Đại diện: Nguyễn Minh Khoa" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvExisting"
                    style="@style/Needs.Note.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    tools:text="Đã đánh giá 20/10/2026 · Trần Thu Hà"
                    tools:visibility="visible" />

                <!-- Số sao -->
                <TextView
                    style="@style/Needs.Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rate_question" />

                <LinearLayout
                    android:id="@+id/layoutStars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnStar1"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_outline" />

                    <ImageButton
                        android:id="@+id/btnStar2"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_outline" />

                    <ImageButton
                        android:id="@+id/btnStar3"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_outline" />

                    <ImageButton
                        android:id="@+id/btnStar4"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_outline" />

                    <ImageButton
                        android:id="@+id/btnStar5"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_outline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStarLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Hài lòng" />

                <TextView
                    android:id="@+id/tvStarHint"
                    style="@style/Needs.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/rate_hint_elder" />

                <!-- Điều cụ thấy tốt -->
                <TextView
                    style="@style/Needs.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/rate_good_label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp" />

                <TextView
                    style="@style/Needs.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/etComment"
                    android:text="@string/rate_comment_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilComment"
                    style="@style/Needs.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="500"
                    app:placeholderText="@string/rate_comment_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etComment"
                        style="@style/Needs.InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="500"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbElderAsked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/rate_elder_asked"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvElderError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:text="@string/rate_error_elder"
                    android:textColor="@color/error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/Needs.Note.Neutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/rate_privacy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitRating"
                    style="@style/Needs.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/rate_submit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReport"
                    style="@style/Needs.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/rate_report_link"
                    app:icon="@drawable/ic_flag" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
