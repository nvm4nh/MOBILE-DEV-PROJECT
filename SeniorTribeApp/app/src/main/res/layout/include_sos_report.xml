<?xml version="1.0" encoding="utf-8"?>
<!-- E09 · Báo khẩn cho bên cùng phối hợp (đầu mối / người được giao) và danh sách báo khẩn. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Needs.Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/sos_section_report" />

    <TextView
        android:id="@+id/tvNoNeeds"
        style="@style/Needs.Note.Neutral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sos_no_needs"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Needs.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/actNeed"
            android:text="@string/sos_label_need" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNeed"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/actNeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="52dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Needs.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sos_label_kind" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMedical"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/sos_kind_medical" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSafety"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_kind_safety" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFire"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_kind_fire" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOther"
                style="@style/Needs.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_kind_other" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            style="@style/Needs.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/etSosNote"
            android:text="@string/sos_label_note" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Needs.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:counterEnabled="true"
            app:counterMaxLength="300"
            app:placeholderText="@string/sos_note_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSosNote"
                style="@style/Needs.InputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/sos_attach_location"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:buttonTint="@color/primary" />

        <TextView
            android:id="@+id/tvCalled"
            style="@style/Needs.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendSos"
            style="@style/Sos.SendButton"
            android:text="@string/sos_send" />

        <TextView
            style="@style/Needs.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/sos_section_alerts" />

        <TextView
            android:id="@+id/tvNoAlerts"
            style="@style/Needs.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sos_no_alerts" />

        <LinearLayout
            android:id="@+id/layoutAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
