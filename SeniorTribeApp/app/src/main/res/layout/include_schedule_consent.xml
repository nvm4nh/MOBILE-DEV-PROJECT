<?xml version="1.0" encoding="utf-8"?>
<!-- F12 · "Ghi nhận đồng ý (đầu mối)": ô tick "Cụ đồng ý với lịch hẹn này" và cách hỏi ý kiến.
     Chỉ chốt lịch được khi đã tick và ghi cách hỏi; Security Rules kiểm tra lại elderConsent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutConsent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Needs.Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:drawableStart="@drawable/ic_check"
        android:text="@string/agree_section_consent" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Needs.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbElderAgreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/agree_consent_checkbox"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:buttonTint="@color/primary" />

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:labelFor="@id/etConsentMethod"
                android:text="@string/agree_label_consent_method" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConsentMethod"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:placeholderText="@string/agree_consent_method_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConsentMethod"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvPrivacyNote"
        style="@style/Needs.Note.Neutral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/agree_privacy_note" />
</LinearLayout>
