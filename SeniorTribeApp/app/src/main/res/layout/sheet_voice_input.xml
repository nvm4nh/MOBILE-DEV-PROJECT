<?xml version="1.0" encoding="utf-8"?>
<!-- E04 · Bảng "Đang nghe": micro, thời gian, sóng âm, chữ đang nhận, nhắc riêng tư. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnVoiceMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_mic_circle"
                android:clickable="true"
                android:contentDescription="@string/voice_mic_desc"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivVoiceMic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/on_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVoiceState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/voice_listening"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVoiceMeta"
                    style="@style/Needs.Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Tiếng Việt · 00:18" />
            </LinearLayout>
        </LinearLayout>

        <com.seniortribe.app.views.VoiceWaveView
            android:id="@+id/voiceWave"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_readonly_field"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Needs.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_transcript_label" />

            <TextView
                android:id="@+id/tvVoiceTranscript"
                style="@style/Assist.BubbleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:maxLines="8"
                android:minLines="2"
                android:scrollbars="vertical"
                tools:text="Cụ ông sống một mình, mong có người đến trò chuyện và đọc báo cùng cụ vào sáng thứ 3 hoặc thứ 5…" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVoiceError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Không nhận được lời nói."
            tools:visibility="visible" />

        <TextView
            style="@style/Needs.Note.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/voice_privacy_warning" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceStop"
                style="@style/Needs.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/voice_stop" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceUse"
                style="@style/Needs.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/voice_use" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
