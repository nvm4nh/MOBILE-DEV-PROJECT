<?xml version="1.0" encoding="utf-8"?>
<!-- E03 · Chi tiết phản ánh: nội dung, quá trình xử lý, kết quả; nút theo vai trò. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootReportDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/reports_title"
        app:titleTextColor="@color/text_primary" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBusy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary" />

    <FrameLayout
        android:id="@+id/frameReportDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollReport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReportStatus"
                        style="@style/Needs.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Đang xử lý" />

                    <TextView
                        android:id="@+id/tvSentBy"
                        style="@style/Needs.Text.Meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        tools:text="Gửi 20/10 · 09:12 · Trần Thu Hà" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Needs.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvReportType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="Không đến đúng lịch hẹn" />

                        <TextView
                            android:id="@+id/tvReportDescription"
                            style="@style/Needs.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textIsSelectable="true"
                            tools:text="Hẹn 15:00 nhưng 16:10 mới đến, không báo trước. Cụ đợi ở cửa gần một tiếng." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/divider" />

                        <TextView
                            android:id="@+id/tvReportRelated"
                            style="@style/Needs.Text.Meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_needs"
                            tools:text="Nhu cầu NC-0151" />

                        <TextView
                            android:id="@+id/tvReportAbout"
                            style="@style/Needs.Text.Meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawableStart="@drawable/ic_groups"
                            tools:text="Về tổ chức: Đoàn TN Phường 7" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Needs.Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_time"
                    android:text="@string/report_timeline" />

                <TextView
                    android:id="@+id/tvNotesEmpty"
                    style="@style/Needs.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_timeline_empty"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Kết quả xử lý: ô nhập cho điều phối viên khi đang xử lý, hoặc thẻ kết quả khi đã đóng -->
                <LinearLayout
                    android:id="@+id/layoutResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Needs.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/etResolution"
                        android:text="@string/report_resolution_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilResolution"
                        style="@style/Needs.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:counterEnabled="true"
                        app:counterMaxLength="1000"
                        app:placeholderText="@string/report_resolution_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etResolution"
                            style="@style/Needs.InputText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="1000"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResultCard"
                    style="@style/Needs.Note.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    tools:text="Kết quả xử lý: Đã trao đổi với tổ chức…"
                    tools:visibility="visible" />

                <TextView
                    style="@style/Needs.Note.Neutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_shield"
                    android:text="@string/report_rules_note" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include layout="@layout/view_list_state" />
    </FrameLayout>

    <include layout="@layout/include_bottom_actions" />
</LinearLayout>
