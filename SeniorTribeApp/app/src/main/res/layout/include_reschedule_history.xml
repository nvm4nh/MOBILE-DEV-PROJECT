<?xml version="1.0" encoding="utf-8"?>
<!-- E02 · Lịch sử thay đổi lịch của lần tiếp nhận: lịch đã chốt, các yêu cầu đổi và kết quả. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Needs.Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:drawableStart="@drawable/ic_time"
        android:text="@string/resched_section_history" />

    <TextView
        android:id="@+id/tvHistoryEmpty"
        style="@style/Needs.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/resched_history_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
