<?xml version="1.0" encoding="utf-8"?>
<!-- E02 · Một dòng lịch sử đổi lịch: nhãn kết quả, khung giờ, lý do và người thực hiện. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Needs.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvHistoryStatus"
            style="@style/Needs.StatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Đã đổi sang lịch mới" />

        <TextView
            android:id="@+id/tvHistorySlot"
            style="@style/Needs.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Thứ 7, 19/10 · 14:00 – 16:00 · Đến nhà" />

        <TextView
            android:id="@+id/tvHistoryDetail"
            style="@style/Needs.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:text="Lý do: thứ 7 đoàn có lịch trực."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvHistoryBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            tools:text="Đề xuất: Nguyễn Minh Khoa · Xác nhận: Trần Thị Mai · 18/10 10:30" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
