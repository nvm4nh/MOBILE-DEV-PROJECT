<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/st_auth_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView 
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/st_auth_brand" android:textColor="@color/st_auth_text"
        android:textSize="18sp" android:fontFamily="@font/be_vietnam_pro_semibold" />
        <TextView 
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/st_login_welcome" android:textColor="@color/st_auth_text"
        android:textSize="28sp" android:layout_marginTop="24dp" android:fontFamily="@font/be_vietnam_pro_semibold" />
<TextView 
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/st_login_note" android:textColor="@color/st_auth_text"
        android:textSize="16sp" android:layout_marginTop="12dp" />
<com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.SeniorTribe.AuthInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:hint="@string/st_register_email" >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/st_login_email"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:inputType="textEmailAddress"
            android:imeOptions="actionNext"
            android:maxLines="1" android:singleLine="true" android:saveEnabled="false"
            android:textColor="@color/st_auth_text" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.SeniorTribe.AuthInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:hint="@string/st_register_password" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/st_login_password"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:maxLines="1" android:singleLine="true" android:saveEnabled="false"
            android:textColor="@color/st_auth_text" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>
<TextView android:id="@+id/st_login_message"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:visibility="gone"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/st_auth_error" android:textSize="14sp" />
<ProgressBar android:id="@+id/st_login_progress"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
        android:contentDescription="@string/st_auth_loading" android:visibility="gone" />
<com.google.android.material.button.MaterialButton
        android:id="@+id/st_login_submit" style="@style/Widget.SeniorTribe.AuthButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:minHeight="52dp"
        android:text="@string/st_login_action" android:textAllCaps="false"
        android:textSize="16sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:gravity="center"
        android:text="@string/st_google_separator" android:textSize="14sp"
        android:textColor="@color/st_auth_secondary" />
<com.google.android.gms.common.SignInButton
        android:id="@+id/st_login_google"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:layout_marginTop="12dp"
        android:contentDescription="@string/st_google_action"
        app:buttonSize="wide" app:colorScheme="light" />
<com.google.android.material.button.MaterialButton
        android:id="@+id/st_login_forgot" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:minHeight="48dp"
        android:text="@string/st_login_forgot" android:textAllCaps="false"
        android:textSize="16sp" />
<com.google.android.material.button.MaterialButton
        android:id="@+id/st_login_register" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:minHeight="48dp"
        android:text="@string/st_login_register" android:textAllCaps="false"
        android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
