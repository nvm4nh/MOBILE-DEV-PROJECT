<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/st_auth_background">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/st_profile_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/st_auth_background" app:title="@string/st_profile_title"
        app:titleTextColor="@color/st_auth_text" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <ProgressBar android:id="@+id/st_profile_progress"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center_horizontal" android:visibility="gone"
                android:contentDescription="@string/st_auth_loading" />
            <TextView android:id="@+id/st_profile_message"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="16sp" android:layout_marginBottom="12dp"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <LinearLayout android:id="@+id/st_profile_form"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/st_profile_personal" android:textAppearance="@style/TextAppearance.SeniorTribe.ProfileHeading" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/st_profile_email_label"
                    android:textColor="@color/st_auth_secondary" android:textSize="14sp" />
                <TextView android:id="@+id/st_profile_email"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/st_auth_text" android:textSize="16sp"
                    android:textIsSelectable="true" android:saveEnabled="false" />
                <TextView android:id="@+id/st_profile_phone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/st_auth_secondary" android:textSize="14sp"
                    android:saveEnabled="false" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/st_profile_name_layout" style="@style/Widget.SeniorTribe.AuthInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:hint="@string/st_profile_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/st_profile_name"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="56dp" android:inputType="textPersonName|textCapWords"
                        android:maxLines="1" android:saveEnabled="false" android:textSize="16sp" android:textColor="@color/st_auth_text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/st_profile_area_layout" style="@style/Widget.SeniorTribe.AuthInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:hint="@string/st_profile_area"
                    app:helperText="@string/st_profile_area_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/st_profile_area"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="56dp" android:inputType="textCapSentences"
                        android:maxLines="1" android:saveEnabled="false" android:textSize="16sp" android:textColor="@color/st_auth_text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/st_profile_save"
                    style="@style/Widget.SeniorTribe.AuthButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:text="@string/st_profile_save" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:text="@string/st_register_uid_label"
                    android:textColor="@color/st_auth_secondary" android:textSize="14sp" />
                <TextView android:id="@+id/st_profile_uid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textColor="@color/st_auth_text" android:textSize="14sp"
                    android:textIsSelectable="true" android:saveEnabled="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/st_profile_copy_uid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:minHeight="52dp" android:textAllCaps="false"
                    android:text="@string/st_register_copy_uid" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:text="@string/st_profile_security"
                    android:textAppearance="@style/TextAppearance.SeniorTribe.ProfileHeading" />
                <TextView android:id="@+id/st_profile_provider_note"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textColor="@color/st_auth_secondary" android:textSize="16sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/st_profile_change_password"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:minHeight="52dp" android:textAllCaps="false"
                    android:text="@string/st_profile_change_password" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/st_profile_reload"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="48dp" android:textAllCaps="false"
                android:text="@string/st_profile_reload" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="@string/st_profile_organizations_title"
                android:textAppearance="@style/TextAppearance.SeniorTribe.ProfileHeading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/st_profile_organizations_note"
                android:textColor="@color/st_auth_secondary" android:textSize="16sp" />
            <ProgressBar android:id="@+id/st_profile_org_progress"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_marginTop="12dp" android:layout_gravity="center_horizontal"
                android:visibility="gone" android:contentDescription="@string/st_auth_loading" />
            <TextView android:id="@+id/st_profile_org_message"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textColor="@color/st_auth_secondary" android:textSize="16sp"
                android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/st_profile_organizations"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/st_profile_org_reload"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:minHeight="48dp" android:textAllCaps="false"
                android:text="@string/st_profile_org_reload" />
            <com.google.android.material.button.MaterialButton android:id="@+id/st_profile_sign_out"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:minHeight="52dp" android:textAllCaps="false"
                android:text="@string/st_register_sign_out" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
