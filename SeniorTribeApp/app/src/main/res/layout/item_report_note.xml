<?xml version="1.0" encoding="utf-8"?>
<!-- E03 · Một mốc trong quá trình xử lý phản ánh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/ivNoteDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_status_dot"
        android:tint="@color/primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNoteKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Hỏi thêm" />

        <TextView
            android:id="@+id/tvNoteText"
            style="@style/Needs.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Lần trước tổ chức có báo trễ qua chat không?" />

        <TextView
            android:id="@+id/tvNoteBy"
            style="@style/Needs.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Lê Hoàng · Điều phối viên · 20/10 · 10:05" />
    </LinearLayout>
</LinearLayout>
