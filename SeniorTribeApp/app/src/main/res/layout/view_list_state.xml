<?xml version="1.0" encoding="utf-8"?>
<!-- Trạng thái dùng chung: đang tải, danh sách rỗng, lỗi tải dữ liệu, chưa được cấp quyền (F16). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutState"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/primary" />

    <FrameLayout
        android:id="@+id/frameStateIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_state_circle">

        <ImageView
            android:id="@+id/ivStateIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_inbox"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Chưa có nhu cầu" />

    <TextView
        android:id="@+id/tvStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxWidth="320dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Các nhu cầu do đơn vị ghi nhận sẽ hiện ở đây." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStateAction"
        style="@style/Needs.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        tools:text="Thử lại" />
</LinearLayout>
