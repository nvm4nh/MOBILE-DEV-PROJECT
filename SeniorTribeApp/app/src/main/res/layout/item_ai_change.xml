<?xml version="1.0" encoding="utf-8"?>
<!-- E05 · Một dòng giải thích thay đổi trong gợi ý (đã viết rõ / đã bỏ thông tin riêng / nên bổ sung). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/ivAiChange"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        app:tint="@color/status_completed" />

    <TextView
        android:id="@+id/tvAiChange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Viết rõ nhu cầu và thời gian mong muốn." />
</LinearLayout>
