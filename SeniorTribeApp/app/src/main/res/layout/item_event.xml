<?xml version="1.0" encoding="utf-8"?>
<!-- E07 · Thẻ sự kiện: ô ngày, tên, tổ chức, giờ, địa điểm, số chỗ đã đăng ký. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Needs.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_event_date"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEventDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="26" />

            <TextView
                android:id="@+id/tvEventMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                tools:text="TH10" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Ngày hội sức khỏe người cao tuổi" />

            <TextView
                android:id="@+id/tvEventOrg"
                style="@style/Needs.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_groups"
                tools:text="Hội CTĐ Quận 3" />

            <TextView
                android:id="@+id/tvEventTime"
                style="@style/Needs.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_time"
                tools:text="Thứ Bảy · 08:00 – 11:00" />

            <TextView
                android:id="@+id/tvEventPlace"
                style="@style/Needs.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_place"
                tools:text="Nhà văn hóa Phường 7" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/surface_variant"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/tvEventCapacity"
                style="@style/Needs.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="18/40 chỗ" />

            <TextView
                android:id="@+id/tvEventMine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="6dp"
                android:drawableTint="@color/primary"
                android:gravity="center_vertical"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Tổ chức bạn đã đăng ký 2 người"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
