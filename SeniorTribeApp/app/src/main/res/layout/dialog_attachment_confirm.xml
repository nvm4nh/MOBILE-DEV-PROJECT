<?xml version="1.0" encoding="utf-8"?>
<!-- E06 · Xác nhận trước khi gửi ảnh / tệp: xem trước, chú thích và nhắc riêng tư. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_chat_attachment"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_attachment"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone"
            android:drawableStart="@drawable/ic_file" />

        <EditText
            android:id="@+id/etCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/chat_attach_caption_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:maxLines="3"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/tvPrivacy"
            style="@style/Needs.Note.Neutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
