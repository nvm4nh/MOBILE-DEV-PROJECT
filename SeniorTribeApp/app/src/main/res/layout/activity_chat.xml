<?xml version="1.0" encoding="utf-8"?>
<!-- F11 · Chat phối hợp theo lần tiếp nhận (Figma "Chat · NC-0142").
     Dải trạng thái phía trên dẫn sang màn hình Thống nhất lịch (F12) hoặc Tiến độ (F13).
     Dùng chung cho dọc và ngang: khi xoay, Activity tạo lại, nội dung đang gõ được EditText
     tự lưu, tin nhắn giữ trong ChatViewModel (T04). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/chatToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/chat_title" />

    <include layout="@layout/include_chat_header" />

    <include
        layout="@layout/include_chat_thread"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
