<?xml version="1.0" encoding="utf-8"?>
<!-- E03 · Thẻ phản ánh: mã nhu cầu, trạng thái, loại, tổ chức liên quan, lần cập nhật. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Needs.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReportCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="NC-0151" />

            <TextView
                android:id="@+id/tvReportStatus"
                style="@style/Needs.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Mới" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReportType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Không đến đúng lịch hẹn" />

        <TextView
            android:id="@+id/tvReportExcerpt"
            style="@style/Needs.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Hẹn 15:00 nhưng 16:10 mới đến, không báo trước…" />

        <TextView
            android:id="@+id/tvReportMeta"
            style="@style/Needs.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Cập nhật 2 giờ trước · về Đoàn TN Phường 7" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
