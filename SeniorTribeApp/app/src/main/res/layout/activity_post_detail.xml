<?xml version="1.0" encoding="utf-8"?>
<!-- F04 · Chi tiết bài đăng theo Figma: thanh ← "Bài đăng" ⋮, tổ chức + giờ đăng, tiêu đề, nội dung,
     ô "Thông tin hoạt động", ghi chú bài không chứa thông tin của người được hỗ trợ. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPostDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/post_detail_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressPostDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- F16 · Đang xem bản đã lưu khi offline -->
            <TextView
                android:id="@+id/tvCachedNotice"
                style="@style/Needs.Note.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:drawableStart="@drawable/ic_cloud_off"
                android:text="@string/post_cached_notice"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailAvatar"
                    style="@style/Post.Avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:textSize="15sp"
                    tools:text="ĐT" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAuthorOrg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:drawableEnd="@drawable/ic_verified_small"
                        tools:text="Đoàn Thanh niên Phường 7" />

                    <TextView
                        android:id="@+id/tvPostDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Đăng lúc 08:15 · 12/10/2026" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPostTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="23sp"
                android:textStyle="bold"
                tools:text="Ngày hội thăm hỏi người cao tuổi tháng 10" />

            <TextView
                android:id="@+id/tvPostContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="16sp"
                tools:text="Sáng Chủ nhật 20/10, đoàn viên Phường 7 đến thăm và trò chuyện cùng 15 cụ trong khu phố." />

            <com.google.android.material.card.MaterialCardView
                style="@style/Needs.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Needs.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/post_event_info" />

                    <TextView
                        android:id="@+id/tvEventTime"
                        style="@style/Needs.Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_time"
                        android:textColor="@color/text_primary"
                        tools:text="Chủ nhật 20/10 · 08:00–11:00" />

                    <TextView
                        android:id="@+id/tvEventPlace"
                        style="@style/Needs.Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_place"
                        android:textColor="@color/text_primary"
                        tools:text="Nhà văn hóa Phường 7, Quận 3" />

                    <TextView
                        android:id="@+id/tvRepresentative"
                        style="@style/Needs.Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_person"
                        android:textColor="@color/text_primary"
                        tools:text="Đại diện: Nguyễn Minh Khoa" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Needs.Note.Neutral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/post_privacy_detail" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
