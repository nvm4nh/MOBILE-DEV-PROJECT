<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/st_auth_background">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/st_register_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/st_auth_background" app:title="@string/st_auth_brand"
        app:titleTextColor="@color/st_auth_text" app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/st_auth_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <LinearLayout
                android:id="@+id/st_register_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/st_register_title"
                    android:textColor="@color/st_auth_text"
                    android:textSize="22sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/st_register_description"
                    android:textColor="@color/st_auth_secondary"
                    android:textSize="14sp" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SeniorTribe.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/st_register_name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/st_register_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="personName"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SeniorTribe.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/st_register_email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/st_register_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SeniorTribe.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/st_register_password"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/st_register_password_hint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/st_register_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SeniorTribe.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/st_register_confirmation"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/st_register_confirmation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/st_auth_light"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/st_register_note"
                        android:textColor="@color/st_auth_text"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/st_register_submit"
                    style="@style/Widget.SeniorTribe.AuthButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/st_register_action" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:gravity="center"
                    android:text="@string/st_google_separator" android:textSize="14sp"
                    android:textColor="@color/st_auth_secondary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/st_register_google" style="@style/Widget.SeniorTribe.GoogleButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/st_google_action" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoToLogin" style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:minHeight="48dp"
                    android:text="@string/st_register_login" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/st_register_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/st_register_result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/st_register_success"
                    android:textColor="@color/st_auth_text"
                    android:textSize="22sp" />
                <TextView
                    android:id="@+id/st_register_result_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/st_register_success_note"
                    android:textColor="@color/st_auth_secondary"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:labelFor="@id/st_register_uid"
                    android:text="@string/st_register_uid_label"
                    android:textColor="@color/st_auth_secondary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/st_register_uid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/st_auth_surface"
                    android:padding="16dp"
                    android:saveEnabled="false"
                    android:textColor="@color/st_auth_text"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/st_register_copy_uid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="52dp"
                    android:text="@string/st_register_copy_uid"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/st_register_retry"
                    style="@style/Widget.SeniorTribe.AuthButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/st_register_retry"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/st_register_sign_out"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="52dp"
                    android:text="@string/st_register_sign_out"
                    android:textAllCaps="false"
                    android:textColor="@color/st_auth_error"
                    app:strokeColor="@color/st_auth_error" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/st_register_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/st_auth_loading"
                android:indeterminateTint="@color/st_auth_primary"
                android:visibility="gone" />
            <TextView
                android:id="@+id/st_register_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/st_auth_error"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
