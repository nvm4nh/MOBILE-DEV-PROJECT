<?xml version="1.0" encoding="utf-8"?>
<!-- F06 · Phần "Sự đồng ý": người cao tuổi đồng ý chia sẻ và cách hỏi ý kiến. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Needs.Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_check"
        android:text="@string/form_section_consent" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Needs.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbConsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/form_consent_check"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvConsentError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/form_error_consent"
                android:textColor="@color/error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:labelFor="@id/etConsentMethod"
                android:text="@string/form_consent_method" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConsentMethod"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:placeholderText="@string/form_consent_method_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConsentMethod"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
