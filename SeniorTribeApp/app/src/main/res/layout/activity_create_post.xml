<?xml version="1.0" encoding="utf-8"?>
<!-- F05 · Đăng / sửa bài theo Figma: "Đăng với tư cách" tổ chức, Tiêu đề, Nội dung, cảnh báo không đăng
     thông tin người được hỗ trợ, phạm vi hiển thị, nút Đăng bài. Thêm 2 ô không bắt buộc cho
     "Thông tin hoạt động" ở màn chi tiết. Form cuộn được nên xoay ngang vẫn dùng được (F16). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCreatePost"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/btn_create_post" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressCreatePost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Đăng với tư cách tổ chức (lấy từ quyền tài khoản, không chọn được) -->
            <LinearLayout
                android:id="@+id/layoutPostAs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_note_neutral"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="invisible"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvPostAsAvatar"
                    style="@style/Post.Avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:textSize="13sp"
                    tools:text="ĐT" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/post_post_as"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPostAsOrg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Đoàn Thanh niên Phường 7" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etPostTitle"
                android:text="@string/post_label_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPostTitle"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="120">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPostTitle"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/post_title_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etPostContent"
                android:text="@string/post_label_content" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPostContent"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="2000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPostContent"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="@string/post_content_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:minLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etEventTime"
                android:text="@string/post_label_event_time" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEventTime"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEventTime"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/post_event_time_hint"
                    android:inputType="text"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Needs.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etEventPlace"
                android:text="@string/post_label_event_place" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEventPlace"
                style="@style/Needs.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEventPlace"
                    style="@style/Needs.InputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/post_event_place_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nhắc như Figma F05 -->
            <TextView
                style="@style/Needs.Note.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/post_privacy_note" />

            <TextView
                style="@style/Needs.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_groups"
                android:text="@string/post_visibility" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPost"
                style="@style/Needs.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:text="@string/post_checking_permission" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
