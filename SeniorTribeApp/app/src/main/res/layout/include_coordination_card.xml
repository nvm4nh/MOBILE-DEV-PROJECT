<?xml version="1.0" encoding="utf-8"?>
<!-- F12, F13 · Thẻ phối hợp trên màn hình chat: bước hiện tại, lịch hẹn và việc cần làm. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCoordination"
    style="@style/Needs.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCoordTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Thống nhất lịch hẹn" />

            <TextView
                android:id="@+id/tvCoordStatus"
                style="@style/Needs.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Đã tiếp nhận" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCoordBody"
            style="@style/Needs.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Đề xuất: 09:00 26/10/2026 · Phường 9, Quận 3. Chờ đầu mối hỏi ý kiến người cao tuổi." />

        <TextView
            android:id="@+id/tvCoordNote"
            style="@style/Needs.Note.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:text="Lần đề xuất trước bị từ chối: cụ bận buổi sáng."
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutCoordActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCoordSecondary"
                style="@style/Needs.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                tools:text="Từ chối" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCoordPrimary"
                style="@style/Needs.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Xác nhận lịch" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
