<?xml version="1.0" encoding="utf-8"?>
<!-- E09 · Cảnh báo "không phải dịch vụ cứu hộ" và ba nút gọi 115 / 113 / 114.
     Nút mở trình quay số của máy với số điền sẵn; người dùng bấm gọi (không gọi nhầm). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sos_note"
        android:drawableStart="@drawable/ic_sos"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:text="@string/sos_disclaimer"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        style="@style/Needs.Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:text="@string/sos_section_call" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall115"
        style="@style/Sos.CallButton"
        android:text="@string/sos_call_115" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall113"
        style="@style/Sos.CallButton"
        android:text="@string/sos_call_113" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall114"
        style="@style/Sos.CallButton"
        android:text="@string/sos_call_114" />

    <TextView
        style="@style/Needs.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sos_call_hint" />
</LinearLayout>
