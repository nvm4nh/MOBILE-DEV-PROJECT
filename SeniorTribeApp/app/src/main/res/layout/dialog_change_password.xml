<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/st_password_message"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/st_profile_password_dialog_note"
            android:textColor="@color/st_auth_text" android:textSize="16sp"
            android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/st_password_fields"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/st_password_current_layout" style="@style/Widget.SeniorTribe.AuthInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="@string/st_profile_current_password" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/st_password_current"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:inputType="textPassword" android:maxLines="1" android:saveEnabled="false" android:textSize="16sp" android:textColor="@color/st_auth_text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/st_password_next_layout" style="@style/Widget.SeniorTribe.AuthInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="@string/st_profile_next_password"
                app:helperText="@string/st_register_password_hint" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/st_password_next"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:inputType="textPassword" android:maxLines="1" android:saveEnabled="false" android:textSize="16sp" android:textColor="@color/st_auth_text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/st_password_repeated_layout" style="@style/Widget.SeniorTribe.AuthInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="@string/st_profile_repeated_password" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/st_password_repeated"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:inputType="textPassword" android:maxLines="1" android:saveEnabled="false" android:textSize="16sp" android:textColor="@color/st_auth_text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/st_password_progress"
            android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal" android:visibility="gone"
            android:contentDescription="@string/st_auth_loading" />
    </LinearLayout>
</ScrollView>
