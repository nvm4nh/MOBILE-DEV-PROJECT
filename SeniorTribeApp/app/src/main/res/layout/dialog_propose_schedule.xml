<?xml version="1.0" encoding="utf-8"?>
<!-- F12 · Tổ chức phụ trách đề xuất lịch hẹn: ngày, giờ, địa điểm chung và ghi chú. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            style="@style/Needs.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/propose_message" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDate"
                style="@style/Needs.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/propose_pick_date"
                app:icon="@drawable/ic_schedule"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickTime"
                style="@style/Needs.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/propose_pick_time"
                app:icon="@drawable/ic_time"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/propose_error_time"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlace"
            style="@style/Needs.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/propose_place_hint"
            app:helperText="@string/propose_place_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlace"
                style="@style/Needs.InputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="200" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNote"
            style="@style/Needs.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/propose_note_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNote"
                style="@style/Needs.InputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
