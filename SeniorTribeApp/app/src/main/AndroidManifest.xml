<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- E01 · Hiện thông báo tin nhắn, lịch hẹn và nhắc lịch (Android 13+ hỏi người dùng) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- E06 · Gọi thoại / video và chụp ảnh gửi trong chat (hỏi người dùng khi cần) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".SeniorTribeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_needs"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_needs"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeniorTribeApp"
        tools:targetApi="31">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SeniorTribeApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Checks the server profile and organization membership before Main. -->
        <activity
            android:name=".activities.SessionGateActivity"
            android:exported="false" />

        <!-- Main Screen -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Needs Management Activities -->
        <activity
            android:name=".activities.CreateNeedActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Không khai báo configChanges: khi xoay, Activity tạo lại để dùng layout-land;
             dữ liệu được giữ bởi ViewModel và trạng thái của các ô nhập. -->
        <activity
            android:name=".activities.NeedDetailActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ReviewNeedActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Community Feed Activities -->
        <activity
            android:name=".activities.CreatePostActivity"
            android:exported="false" />
        <activity
            android:name=".activities.PostDetailActivity"
            android:exported="false" />

        <!-- Chat, lịch hẹn, đối soát (F11–F13) và lịch sử hỗ trợ (F15) -->
        <activity
            android:name=".activities.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.ScheduleAgreementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.NeedProgressActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.NeedHistoryActivity"
            android:exported="false" />

        <!-- E01 · Tùy chọn thông báo và nhắc lịch -->
        <activity
            android:name=".activities.NotificationSettingsActivity"
            android:exported="false" />

        <!-- E06 · Gọi thoại / video. Tự xử lý xoay màn hình để cuộc gọi không bị ngắt khi
             Activity tạo lại; bố cục FrameLayout tự co giãn theo chiều ngang / dọc. -->
        <activity
            android:name=".activities.CallActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SeniorTribeApp.Call" />

        <!-- E06 · Xem ảnh gửi trong chat -->
        <activity
            android:name=".activities.ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.SeniorTribeApp.Viewer" />

        <!-- E06 · Chia sẻ tạm ảnh chụp / tệp mở bằng ứng dụng khác (chỉ thư mục cache/shared) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- E02 · Đổi lịch sau khi đã chốt -->
        <activity
            android:name=".activities.RescheduleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
