rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function owns(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    function validProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email',
          'area', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email',
          'area', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.email is string
        && data.email == request.auth.token.email
        && data.area is string
        && data.area.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;

      allow create: if owns(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['displayName', 'area', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /memberships/{uid}/organizations/{organizationId} {
      allow get, list: if owns(uid);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}