<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="st_auth_primary">#1F6F5C</color>
    <color name="st_auth_light">#CDEDE0</color>
    <color name="st_auth_background">#F1F6F3</color>
    <color name="st_auth_surface">#FFFFFF</color>
    <color name="st_auth_text">#18201C</color>
    <color name="st_auth_secondary">#52615A</color>
    <color name="st_auth_error">#B3261E</color>

    <style name="Theme.SeniorTribe.Auth" parent="Theme.SeniorTribeApp">
        <item name="colorPrimary">@color/st_auth_primary</item>
        <item name="colorPrimaryVariant">@color/st_auth_primary</item>
        <item name="colorOnPrimary">@color/st_auth_surface</item>
        <item name="colorSecondary">@color/st_auth_primary</item>
        <item name="colorError">@color/st_auth_error</item>
        <item name="android:textColorPrimary">@color/st_auth_text</item>
        <item name="android:textColorSecondary">@color/st_auth_secondary</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:windowBackground">@color/st_auth_background</item>
        <item name="android:statusBarColor">@color/st_auth_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/st_auth_background</item>
    </style>

    <style name="Widget.SeniorTribe.AuthInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/st_auth_surface</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/st_auth_secondary</item>
        <item name="errorTextColor">@color/st_auth_error</item>
    </style>

    <style name="Widget.SeniorTribe.AuthButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <string name="st_auth_brand">SeniorTribe</string>
    <string name="st_register_title">Tạo tài khoản</string>
    <string name="st_register_description">Đăng ký để tham gia hoạt động cùng tổ chức của bạn.</string>
    <string name="st_register_name">Họ tên</string>
    <string name="st_register_email">Email</string>
    <string name="st_register_password">Mật khẩu</string>
    <string name="st_register_confirmation">Nhập lại mật khẩu</string>
    <string name="st_register_password_hint">Ít nhất 8 ký tự</string>
    <string name="st_register_note">Tài khoản mới chưa có quyền tổ chức. Liên hệ người phụ trách đơn vị để được cấp quyền.</string>
    <string name="st_register_action">Tạo tài khoản</string>
    <string name="st_register_back">← Về Đăng nhập</string>
    <string name="st_auth_loading">Đang xử lý</string>
    <string name="st_register_creating">Đang tạo tài khoản…</string>
    <string name="st_register_saving">Đang lưu hồ sơ…</string>
    <string name="st_register_saving_note">Tài khoản đã được tạo. Vui lòng chờ lưu hồ sơ hoàn tất.</string>
    <string name="st_register_success">Đã lưu hồ sơ tài khoản</string>
    <string name="st_register_success_note">Quyền nghiệp vụ được cấp riêng bởi tổ chức. Bạn có thể sao chép mã tài khoản để gửi cho người phụ trách đơn vị.</string>
    <string name="st_register_profile_incomplete">Hồ sơ chưa hoàn tất</string>
    <string name="st_register_profile_incomplete_note">Tài khoản đã được tạo nhưng hồ sơ chưa lưu được. Nhấn “Thử lại lưu hồ sơ” để tiếp tục.</string>
    <string name="st_register_uid_label">Mã tài khoản</string>
    <string name="st_register_copy_uid">Sao chép mã tài khoản</string>
    <string name="st_register_uid_copied">Đã sao chép mã tài khoản</string>
    <string name="st_register_retry">Thử lại lưu hồ sơ</string>
    <string name="st_register_sign_out">Đăng xuất về Đăng nhập</string>
    <string name="st_auth_wait">Vui lòng chờ thao tác đang xử lý hoàn tất.</string>
    <string name="st_auth_error_name">Họ tên cần từ 2 đến 80 ký tự.</string>
    <string name="st_auth_error_email">Vui lòng nhập email hợp lệ.</string>
    <string name="st_auth_error_password_required">Vui lòng nhập mật khẩu.</string>
    <string name="st_auth_error_password_length">Mật khẩu cần ít nhất 8 ký tự.</string>
    <string name="st_auth_error_password_match">Mật khẩu nhập lại chưa khớp.</string>
    <string name="st_auth_error_email_in_use">Email đã được đăng ký. Vui lòng dùng email khác hoặc đăng nhập.</string>
    <string name="st_auth_error_weak_password">Mật khẩu chưa đáp ứng yêu cầu bảo mật. Vui lòng chọn mật khẩu mạnh hơn.</string>
    <string name="st_auth_error_disabled">Tài khoản đã bị vô hiệu hóa. Vui lòng liên hệ người phụ trách.</string>
    <string name="st_auth_error_network">Chưa kết nối được máy chủ. Kiểm tra kết nối mạng rồi thử lại.</string>
    <string name="st_auth_error_rate_limit">Có quá nhiều yêu cầu. Vui lòng thử lại sau.</string>
    <string name="st_auth_error_permission">Không có quyền đọc hoặc lưu hồ sơ. Vui lòng liên hệ người phụ trách.</string>
    <string name="st_auth_error_session">Phiên đăng nhập đã thay đổi. Vui lòng đăng xuất rồi đăng nhập lại.</string>
    <string name="st_auth_error_profile">Dữ liệu hồ sơ chưa hợp lệ. Vui lòng liên hệ người phụ trách.</string>
    <string name="st_auth_error_generic">Thao tác chưa hoàn tất. Vui lòng thử lại.</string>
</resources>
