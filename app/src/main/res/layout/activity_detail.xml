<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F6F2"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#19231F" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Chi tiết bài đăng"
                android:textColor="#19231F"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDetailMenu"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Tùy chọn bài đăng"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                android:tint="#52665D" />
        </LinearLayout>

        <!-- POST CARD: KHUNG BÀI ĐĂNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- THÔNG TIN ĐƠN VỊ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailAvatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="ĐT"
                    android:textColor="#104C40"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDetailOrganization"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đoàn Thanh niên Phường 7"
                            android:textColor="#19231F"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="5dp"
                            android:contentDescription="Đơn vị đã xác minh"
                            android:src="@drawable/ic_verified" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="2 giờ trước"
                        android:textColor="#617068"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TIÊU ĐỀ BÀI ĐĂNG -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Ngày hội thăm hỏi người cao tuổi tháng 10"
                android:textColor="#19231F"
                android:textSize="23sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />

            <!-- NỘI DUNG BÀI ĐĂNG -->
            <TextView
                android:id="@+id/tvDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Sáng Chủ nhật 20/10, đoàn viên phường 7 đến thăm và trò chuyện cùng 15 cụ trong khu phố. Đơn vị muốn phối hợp vui lòng nhắn đại diện qua ứng dụng."
                android:textColor="#202923"
                android:textSize="18sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>
        <!-- KẾT THÚC KHUNG BÀI ĐĂNG -->

        <!-- PRIVACY NOTICE: KHUNG RIÊNG BÊN DƯỚI -->
        <LinearLayout
            android:id="@+id/layoutPrivacyNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notice"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="Thông tin được bảo vệ"
                android:src="@drawable/ic_lock_notice" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:text="Bài đăng không chứa tên, địa chỉ hay số điện thoại của người được hỗ trợ."
                android:textColor="#52665D"
                android:textSize="16sp" />

        </LinearLayout>
        <!-- KẾT THÚC KHUNG THÔNG BÁO RIÊNG -->

    </LinearLayout>
</ScrollView>
